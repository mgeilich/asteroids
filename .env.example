# NASA API Key (Get a free one at https://api.nasa.gov/ or leave empty to use DEMO_KEY)
NASA_API_KEY=DEMO_KEY

# TRMNL Webhook Integration Settings
# 1. Custom Plugin Webhook URL (for PUSH strategy)
# Format: https://trmnl.com/api/custom_plugins/YOUR_PLUGIN_UUID
TRMNL_WEBHOOK_URL=

# 2. Flask Server Port (for POLL strategy, defaults to 5000)
PORT=5000
