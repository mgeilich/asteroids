{% if radar_ticks_full and radar_ticks_full.size > 0 %}
<div class="layout layout--col gap--small">
  <div class="grid grid--cols-6 portrait:grid--cols-1 gap--small w--full grow p--1">
    
    <!-- Left Column: Radar -->
    <div class="col--span-3 portrait:col--span-1">
      <div class="flex flex--col flex--center-x mx--auto">
        <svg width="280" height="260" viewBox="0 0 280 260" preserveAspectRatio="xMidYMid meet" fill="none" xmlns="http://www.w3.org/2000/svg" class="text--black">
          <defs>
            <clipPath id="label-clip">
              <rect x="5" y="5" width="270" height="250" />
            </clipPath>
          </defs>
          <!-- Radar Grid Boundaries and Rings -->
          <g stroke="currentColor" fill="none">
            <!-- Outer tick border and radar boundary -->
            <circle cx="140" cy="130" r="124" stroke-width="1" stroke-dasharray="1 5" />
            <circle cx="140" cy="130" r="120" stroke-width="2" />
            
            <!-- Concentric distance rings (10, 20, 30, 40 LD) -->
            <g stroke-width="1" stroke-dasharray="3 6">
              <circle cx="140" cy="130" r="90" />
              <circle cx="140" cy="130" r="60" />
              <circle cx="140" cy="130" r="30" />
            </g>
            
            <!-- Crosshair grid axes -->
            <line x1="140" y1="6" x2="140" y2="254" stroke-width="1" stroke-dasharray="2 4" />
            <line x1="16" y1="130" x2="264" y2="130" stroke-width="1" stroke-dasharray="2 4" />
          </g>
          
          <!-- Center marker representing Earth -->
          <circle cx="140" cy="130" r="4" fill="currentColor" />
          
          <!-- Distance, Center, and Time Labels -->
          <g fill="currentColor" font-family="sans-serif" font-size="9" font-weight="bold">
            <text x="170" y="125" text-anchor="middle" fill="currentColor">10 LD</text>
            <text x="200" y="125" text-anchor="middle" fill="currentColor">20 LD</text>
            <text x="230" y="125" text-anchor="middle" fill="currentColor">30 LD</text>
            <text x="260" y="125" text-anchor="end" fill="currentColor">40 LD</text>
            <text x="140" y="144" text-anchor="middle" fill="currentColor">EARTH</text>
            <text x="140" y="10" text-anchor="middle" fill="currentColor">NOW (T-0)</text>
          </g>
          
          <!-- Day Ticks (calculated by backend) -->
          {% if radar_ticks_full %}
            <g stroke="currentColor" stroke-width="1.5">
              {% for tick in radar_ticks_full %}
                {% if tick and tick.x1 and tick.y1 and tick.x2 and tick.y2 %}
                  <line x1="{{ tick.x1 }}" y1="{{ tick.y1 }}" x2="{{ tick.x2 }}" y2="{{ tick.y2 }}" />
                {% endif %}
              {% endfor %}
            </g>
          {% endif %}
          
          <!-- Day Ticks Labels -->
          {% if radar_ticks_full %}
            <g fill="currentColor" font-family="sans-serif" font-size="8" font-weight="bold">
              {% for tick in radar_ticks_full %}
                {% if tick and tick.label_x and tick.label_y %}
                  <text x="{{ tick.label_x }}" y="{{ tick.label_y }}" text-anchor="{{ tick.anchor | default: 'middle' }}" fill="currentColor">
                    {{- tick.label | default: '—' -}}
                  </text>
                {% endif %}
              {% endfor %}
            </g>
          {% endif %}
          
          <!-- Asteroids (calculated by backend) -->
          {% if radar_asteroids_full and radar_asteroids_full.size > 0 %}
            <g stroke="currentColor" stroke-width="1.5" fill="none">
              {% for ast in radar_asteroids_full %}
                {% if ast and ast.x and ast.y %}
                  <circle cx="{{ ast.x }}" cy="{{ ast.y }}" r="{{ ast.r | default: 3 }}" {% if ast.is_hazardous %}fill="currentColor"{% endif %} />
                {% endif %}
              {% endfor %}
            </g>
            <g fill="currentColor" clip-path="url(#label-clip)" font-family="sans-serif" font-size="9" font-weight="bold">
              {% if radar_asteroids_full.size == 0 %}
                <text x="140" y="110" text-anchor="middle" fill="currentColor">CLEAR SECTOR</text>
              {% endif %}
              {% for ast in radar_asteroids_full %}
                {% if ast and ast.label_x1 and ast.label_y1 %}
                  {% if ast.name_part_2 %}
                    <text x="{{ ast.label_x1 }}" y="{{ ast.label_y1 }}" text-anchor="{{ ast.anchor | default: 'start' }}" fill="currentColor">{{ ast.name_part_1 }}</text>
                    <text x="{{ ast.label_x2 }}" y="{{ ast.label_y2 }}" text-anchor="{{ ast.anchor | default: 'start' }}" fill="currentColor">{{ ast.name_part_2 }}</text>
                  {% else %}
                    <text x="{{ ast.label_x1 }}" y="{{ ast.label_y1 }}" text-anchor="{{ ast.anchor | default: 'start' }}" fill="currentColor">{{ ast.name_part_1 }}</text>
                  {% endif %}
                {% endif %}
              {% endfor %}
            </g>
          {% endif %}
        </svg>
      </div>
    </div>
    
    <!-- Right Column: Status & Schedule Details -->
    <div class="col--span-3 portrait:col--span-1">
      <div class="flex flex--col gap--small grow">
        <!-- Header -->
        <div class="title text--bold text--small lg:text--base portrait:text--small">PLANETARY DEFENSE</div>
        <div class="label mb--1">NEO RADAR MONITOR</div>
        
        <!-- System Warning / Status Ticker -->
        <div class="flex flex--row gap--small w--full">
          {% if system_status contains "WARNING" %}
            <div class="p--1 rounded bg--black text--white text--center text--bold mb--1 grow">
              {{ system_status }}
            </div>
          {% else %}
            <div class="border rounded bg--white text--black p--1 text--center text--bold mb--1 grow">
              {{ system_status }}
            </div>
          {% endif %}
        </div>
        
        <!-- Key Statistics Summary -->
        <div class="flex flex--row gap--small mb--1">
          <div class="grow text--center bg--gray-75 text--black rounded p--0.5">
            <div class="label text--bold">NEOS DETECTED</div>
            <div class="value value--base lg:value--large">{{ total_count | default: '—' }}</div>
          </div>
          <div class="grow text--center bg--gray-75 text--black rounded p--0.5">
            <div class="label text--bold">CLOSEST APPROACH</div>
            <div class="value value--base lg:value--large">{{ closest_dist_ld | default: '—' }}</div>
          </div>
        </div>
        
        <!-- Closest Scheduled Flybys -->
        <div class="flex flex--col gap--small">
          <div class="label text--bold">CLOSEST SCHEDULED FLYBY (TOP 1)</div>
          
          {% if closest_list and closest_list.size > 0 %}
            {% for item in closest_list limit: 1 %}
              <div class="flex flex--row flex--center-y gap--small p--1 rounded bg--gray-75 text--black">
                <div class="grow">
                  <div class="text--bold text--medium" data-clamp="1">{{ item.name | default: '—' }}</div>
                  <div class="label text--small" data-clamp="1">{{ item.time_str | default: '—' }} &bull; Size: {{ item.size_m | default: '—' }}</div>
                </div>
                <div class="text--right flex flex--col layout--right">
                  <div class="text--bold text--medium" data-clamp="1">{{ item.dist_ld | default: '—' }} LD</div>
                  {% if item.is_hazardous != "" and item.is_hazardous != nil %}
                    <span class="bg--black text--white px--2 rounded text--bold text--small">HAZARD</span>
                  {% endif %}
                </div>
              </div>
            {% endfor %}
          {% else %}
            <div class="p--3 text--black rounded text--center label">
              No NEO activity detected.
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>
{% else %}
<div class="layout layout--col">
  <div class="p--4 text--black rounded text--center label grow flex flex--center-x flex--center-y">
    Radar scan offline. System checking for telemetry updates...
  </div>
</div>
{% endif %}
{% render 'title_bar' %}
