{% if radar_ticks_full and radar_ticks_full.size > 0 %}
<div class="layout layout--col gap--small">
  <div class="grid grid--cols-6 portrait:grid--cols-1 gap--small w--full grow p--1">
    
    <!-- Left Column: Radar -->
    <div class="col--span-3 portrait:col--span-1">
      <div class="flex flex--col layout--center-x mx--auto" style="width: 100%; max-width: 280px; height: auto;">
        {% render 'radar_svg', layout: 'full', ticks: radar_ticks_full, asteroids: radar_asteroids_full %}
      </div>
    </div>
    
    <!-- Right Column: Status & Schedule Details -->
    <div class="col--span-3 portrait:col--span-1">
      <div class="flex flex--col gap--small grow">
        <!-- Header -->
        <div class="title title--small lg:title--base portrait:title--small">PLANETARY DEFENSE</div>
        <div class="label mb--1">NEO RADAR MONITOR</div>
        
        <!-- System Warning / Status Ticker -->
        <div class="grid grid--cols-1 w--full">
          {% if system_status contains "WARNING" or system_status contains "DEMO" %}
            <div class="p--1 rounded bg--black text--inverse layout--center-x mb--1">
              <span class="label"><strong>{{ system_status }}</strong></span>
            </div>
          {% else %}
            <div class="border rounded bg--white p--1 layout--center-x mb--1">
              <span class="label"><strong>{{ system_status }}</strong></span>
            </div>
          {% endif %}
        </div>
        
        <!-- Key Statistics Summary -->
        <div class="grid grid--cols-2 gap--small mb--1">
          <div class="bg--gray-75 rounded p--1 layout--center-x">
            <div class="label">NEOS DETECTED</div>
            <div class="value value--base">{{ total_count | default: '—' }}</div>
          </div>
          <div class="bg--gray-75 rounded p--1 layout--center-x">
            <div class="label">CLOSEST APPROACH</div>
            <div class="value value--base">{{ closest_dist_ld | default: '—' }}</div>
          </div>
        </div>
        
        <!-- Closest Scheduled Flybys -->
        <div class="flex flex--col gap--small">
          <div class="label"><strong>CLOSEST SCHEDULED FLYBYS (TOP 3)</strong></div>
          
          {% if closest_list and closest_list.size > 0 %}
            {% for item in closest_list limit: 3 %}
              <div class="flex flex--row flex--center-y gap--small p--1 rounded bg--gray-75 grow">
                <div class="grow">
                  <div class="title title--small" data-clamp="1">{{ item.name | default: '—' }}</div>
                  <div class="label label--small" data-clamp="1">{{ item.time_str | default: '—' }} &bull; Size: {{ item.size_m | default: '—' }}</div>
                </div>
                <div class="text--right flex flex--col layout--right">
                  <div class="value value--small" data-clamp="1">{{ item.dist_ld | default: '—' }} LD</div>
                  {% if item.is_hazardous != "" and item.is_hazardous != nil %}
                    <span class="bg--black text--inverse px--2 rounded label label--small"><strong>HAZARD</strong></span>
                  {% endif %}
                </div>
              </div>
            {% endfor %}
          {% else %}
            <div class="p--3 rounded layout--center-x label">
              No NEO activity detected.
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
</div>
{% else %}
<div class="layout layout--col layout--center">
  <div class="p--4 label">
    Radar scan offline. System checking for telemetry updates...
  </div>
</div>
{% endif %}
{% render 'title_bar' %}
