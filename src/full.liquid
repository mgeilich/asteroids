<div class="layout layout--col gap--small">
  {% if scan_completed %}
    <!-- Radar Section (Centered, full-width) -->
    <div class="flex flex--col flex--center-x w--full">
      <div class="w--full h--auto overflow--hidden flex flex--col flex--center-x">
        {% render 'radar_svg', layout: 'full', ticks: radar_ticks_full, asteroids: radar_asteroids_full %}
      </div>
    </div>
    
    <!-- Status & Information Panel -->
    <div class="flex flex--col gap--small w--full grow p--1">
      <!-- Header / Title Row -->
      <div class="flex flex--row flex--center-y gap--small w--full">
        <div>
          <div class="title title--base">PLANETARY DEFENSE</div>
          <div class="label">NEO RADAR MONITOR</div>
        </div>
        
        <div class="flex flex--row items--center gap--small ml--auto">
          {% if system_status contains "WARNING" or system_status contains "DEMO" %}
            <div class="label label--error p--1 flex flex--row flex--center-x">
              <strong>{{ system_status }}</strong>
            </div>
          {% else %}
            <div class="label label--outline p--1 flex flex--row flex--center-x">
              <strong>{{ system_status }}</strong>
            </div>
          {% endif %}
        </div>
      </div>
      
      <!-- Key Statistics row -->
      <div class="grid grid--cols-2 gap--small w--full">
        <div class="bg--gray-75 rounded p--1.5 flex flex--row gap--small flex--center-x flex--center-y">
          <span class="label">NEOS DETECTED:</span>
          <span class="value value--base">{{ total_count | default: '—' }}</span>
        </div>
        <div class="bg--gray-75 rounded p--1.5 flex flex--row gap--small flex--center-x flex--center-y">
          <span class="label">CLOSEST APPROACH:</span>
          <span class="value value--base">{{ closest_dist_ld | default: '—' }}</span>
        </div>
      </div>
      
      <!-- Closest Scheduled Flybys -->
      <div class="flex flex--col gap--xsmall w--full">
        <div class="label"><strong>CLOSEST SCHEDULED FLYBYS</strong></div>
        
        {% if closest_list and closest_list.size > 0 %}
          <div class="grid grid--cols-3 gap--small w--full">
            {% for item in closest_list limit: 3 %}
              <div class="rounded bg--gray-75 p--1">
                <div class="flex flex--col gap--xsmall">
                  <div class="title title--small" data-clamp="1">{{ item.name | default: '—' }}</div>
                  <div class="label label--small" data-clamp="1">{{ item.time_str | default: '—' }}</div>
                  <div class="flex flex--row flex--center-y gap--small mt--1">
                    <span class="value value--small">{{ item.dist_ld | default: '—' }} LD</span>
                    {% if item.is_hazardous == true %}
                      <span class="label label--error px--1 ml--auto"><strong>HAZARD</strong></span>
                    {% endif %}
                  </div>
                </div>
              </div>
            {% endfor %}
          </div>
        {% else %}
          <div class="p--3 rounded flex flex--row flex--center-x label w--full bg--gray-75">
            No NEO activity detected.
          </div>
        {% endif %}
      </div>
    </div>
  {% else %}
    <div class="flex flex--col layout--center grow">
      <div class="p--4 label">
        Radar scan offline. System checking for telemetry updates...
      </div>
    </div>
  {% endif %}
</div>
{% render 'title_bar' %}
