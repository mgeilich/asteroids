<div class="layout layout--col layout--stretch p--1">
  {% if scan_completed %}
    <div class="grid grid--cols-2 portrait:grid--cols-1 gap--small w--full grow">
      
      <!-- Left Column: Linear Coordinate Timeline Chart -->
      <div class="w--full flex flex--col flex--center-x flex--center-y grow">
        <svg width="360" height="260" viewBox="0 0 360 260" preserveAspectRatio="xMidYMid meet" fill="none" font-family="sans-serif" xmlns="http://www.w3.org/2000/svg" class="w--full max-w--full h--auto portrait:w--full">
          <defs>
            <clipPath id="chart-clip-full">
              <rect x="38" y="18" width="310" height="214" />
            </clipPath>
          </defs>

          <!-- Axes -->
          <g stroke="#000" stroke-width="1.5">
            <!-- Y-axis (Distance / NOW) & X-axis (Earth / Future Days) -->
            <line x1="46" y1="20" x2="46" y2="230" />
            <line x1="46" y1="230" x2="350" y2="230" stroke-width="2" />
          </g>

          <!-- Horizontal Distance Gridlines -->
          {% if chart_gridlines_full and chart_gridlines_full.size > 0 %}
            <g stroke="#000" stroke-width="1" stroke-dasharray="2 4">
              {% for line in chart_gridlines_full %}
                {% if line and line.y %}
                  <line x1="46" y1="{{ line.y }}" x2="350" y2="{{ line.y }}" />
                {% endif %}
              {% endfor %}
            </g>
            <g fill="#000" font-family="sans-serif">
              {% for line in chart_gridlines_full %}
                {% if line and line.y and line.label %}
                  <text x="{{ line.x_label | default: 42 }}" y="{{ line.y }}" dy="3" text-anchor="end">
                    {{- line.label -}}
                  </text>
                {% endif %}
              {% endfor %}
              <text x="42" y="230" dy="3" text-anchor="end">Earth</text>
            </g>
          {% endif %}

          <!-- Header Labels -->
          <g fill="#000" font-weight="bold" font-family="sans-serif">
            <text x="46" y="14" text-anchor="start">NOW (T-0)</text>
            <text x="350" y="14" text-anchor="end">T+7 DAYS</text>
          </g>

          <!-- Time Ticks along Bottom X-axis -->
          {% if chart_ticks_full and chart_ticks_full.size > 0 %}
            <g stroke="#000" stroke-width="1.5">
              {% for tick in chart_ticks_full %}
                {% if tick and tick.x %}
                  <line x1="{{ tick.x }}" y1="{{ tick.y_tick_top | default: 230 }}" x2="{{ tick.x }}" y2="{{ tick.y_tick_bottom | default: 234 }}" />
                {% endif %}
              {% endfor %}
            </g>
            <g fill="#000" font-family="sans-serif">
              {% for tick in chart_ticks_full %}
                {% if tick and tick.x and tick.label and tick.is_now != true %}
                  <text x="{{ tick.x }}" y="{{ tick.y_label | default: 244 }}" text-anchor="middle">
                    {{- tick.label -}}
                  </text>
                {% endif %}
              {% endfor %}
            </g>
          {% endif %}

          <!-- Asteroid Markers and Labels -->
          {% if chart_asteroids_full and chart_asteroids_full.size > 0 %}
            <g stroke="#000" stroke-width="1.5" clip-path="url(#chart-clip-full)">
              {% for ast in chart_asteroids_full %}
                {% if ast and ast.x and ast.y %}
                  <circle cx="{{ ast.x }}" cy="{{ ast.y }}" r="{{ ast.r | default: 4 }}" {% if ast.is_hazardous %}fill="#000"{% else %}fill="none"{% endif %} />
                {% endif %}
              {% endfor %}
            </g>
            <g fill="#000" font-family="sans-serif" clip-path="url(#chart-clip-full)">
              {% for ast in chart_asteroids_full %}
                {% if ast and ast.label_x and ast.label_y and ast.name %}
                  <text x="{{ ast.label_x }}" y="{{ ast.label_y }}" text-anchor="{{ ast.anchor | default: 'start' }}" data-clamp="1">
                    {{- ast.name -}}
                  </text>
                {% endif %}
              {% endfor %}
            </g>
          {% else %}
            <g fill="#000" font-family="sans-serif">
              <text x="192.5" y="130" text-anchor="middle">NO ASTEROIDS IN RANGE</text>
            </g>
          {% endif %}
        </svg>
      </div>

      <!-- Right Column: Telemetry Header, Stats & Closest Flybys -->
      <div class="w--full flex flex--col grow">
        <div class="flex flex--col gap--space-between w--full grow">
          
          <!-- Header / Status Row -->
          <div class="flex flex--row flex--center-y gap--small w--full">
            <div>
              <div class="title title--base">PLANETARY DEFENSE</div>
              <div class="label">NEO TIMELINE MONITOR</div>
            </div>
            
            <div class="flex flex--row flex--center-y gap--small ml--auto">
              {% if is_alert %}
                <div class="label label--filled p--1 flex flex--row flex--center-x">
                  {{ system_status }}
                </div>
              {% else %}
                <div class="label label--outline p--1 flex flex--row flex--center-x">
                  {{ system_status }}
                </div>
              {% endif %}
            </div>
          </div>
          
          <!-- Key Statistics Grid -->
          <div class="grid grid--cols-2 portrait:grid--cols-1 gap--small w--full">
            <div class="bg--gray-75 rounded p--1 flex flex--col flex--center-x">
              <span class="label">UPCOMING (7D)</span>
              <span class="value value--base portrait:value--small">{{ total_count | default: '—' }}</span>
            </div>
            <div class="bg--gray-75 rounded p--1 flex flex--col flex--center-x">
              <span class="label">CLOSEST APPROACH</span>
              <span class="value value--base portrait:value--small">{{ closest_dist_ld | default: '—' }}</span>
            </div>
          </div>
          
          <!-- Closest Scheduled Flybys -->
          <div class="flex flex--col gap--xsmall w--full">
            <div class="label">CLOSEST SCHEDULED FLYBYS</div>
            
            {% if closest_list and closest_list.size > 0 %}
              <div class="grid grid--cols-1 gap--xsmall w--full">
                {% for item in closest_list limit: 2 %}
                  <div class="rounded bg--gray-75 p--1">
                    <div class="flex flex--row flex--center-y gap--space-between w--full">
                      <div class="grow">
                        <div class="title title--small" data-clamp="1">{{ item.name | default: '—' }}</div>
                        <div class="label label--small" data-clamp="1">{{ item.time_str | default: '—' }} &bull; Size: {{ item.size_m | default: '—' }}</div>
                      </div>
                      <div class="text--right flex flex--col ml--auto">
                        <div class="value value--small" data-clamp="1">{{ item.dist_ld | default: '—' }} LD</div>
                        {% if item.is_hazardous == true %}
                          <span class="label label--filled px--1">HAZARD</span>
                        {% endif %}
                      </div>
                    </div>
                  </div>
                {% endfor %}
              </div>
            {% else %}
              <div class="p--3 rounded flex flex--row flex--center-x label w--full bg--gray-75">
                No NEO activity detected.
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  {% else %}
    <div class="flex flex--col layout--center grow">
      <div class="p--4 label">
        {{ last_error | default: 'Timeline scan offline. System checking for telemetry updates...' }}
      </div>
    </div>
  {% endif %}
</div>
{% render 'title_bar' %}
