  {% render 'title_bar' %}
  <div class="layout layout--col">
    <div class="grid grid--cols-12 gap--large p--2 w--full">
    
    <!-- Left Column: Radar (450px wide) -->
    <div class="col--span-6 flex flex--col layout--center-x">
      {% if radar_ticks_full and radar_ticks_full.size > 0 %}
        <svg width="440" height="420" viewBox="0 0 440 420" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg" class="text--black radar-svg radar-svg--full">
              <!-- Radar Grid Boundaries and Rings -->
              <g class="radar-grid-group">
                <!-- Outer tick border and radar boundary -->
                <circle cx="220" cy="220" r="200" class="grid-outer-boundary grid-outer-boundary--large" />
                <circle cx="220" cy="220" r="195" class="grid-inner-boundary--large" />
                
                <!-- Concentric distance rings (10, 20, 30, 40 LD) -->
                <g class="grid-range-rings grid-range-rings--large">
                  <circle cx="220" cy="220" r="150" />
                  <circle cx="220" cy="220" r="100" />
                  <circle cx="220" cy="220" r="50" />
                </g>
                
                <!-- Crosshair grid axes -->
                <line x1="220" y1="20" x2="220" y2="420" class="grid-crosshairs" />
                <line x1="20" y1="220" x2="420" y2="220" class="grid-crosshairs" />
              </g>
              
              <!-- Center marker representing Earth -->
              <circle cx="220" cy="220" r="5" class="radar-center-marker" />
              
              <!-- Distance, Center, and Time Labels -->
              <g fill="currentColor" class="text--bold">
                <text x="270" y="215" text-anchor="middle" data-fit-value="true" textLength="35" lengthAdjust="spacingAndGlyphs">10 LD</text>
                <text x="320" y="215" text-anchor="middle" data-fit-value="true" textLength="35" lengthAdjust="spacingAndGlyphs">20 LD</text>
                <text x="370" y="215" text-anchor="middle" data-fit-value="true" textLength="35" lengthAdjust="spacingAndGlyphs">30 LD</text>
                <text x="415" y="215" text-anchor="end" data-fit-value="true" textLength="35" lengthAdjust="spacingAndGlyphs">40 LD</text>
                <text x="220" y="234" text-anchor="middle" data-fit-value="true" textLength="40" lengthAdjust="spacingAndGlyphs">EARTH</text>
                <text x="220" y="15" text-anchor="middle" data-fit-value="true" textLength="60" lengthAdjust="spacingAndGlyphs">NOW (T-0)</text>
              </g>
              
              <!-- Day Ticks (calculated by backend) -->
              {% if radar_ticks_full %}
                <g class="radar-ticks-group">
                  {% for tick in radar_ticks_full %}
                    {% if tick and tick.x1 and tick.y1 and tick.x2 and tick.y2 %}
                      <line x1="{{ tick.x1 }}" y1="{{ tick.y1 }}" x2="{{ tick.x2 }}" y2="{{ tick.y2 }}" />
                    {% endif %}
                  {% endfor %}
                </g>
              {% endif %}
              
              <!-- Day Ticks Labels -->
              {% if radar_ticks_full %}
                <g fill="currentColor">
                  {% for tick in radar_ticks_full %}
                    {% if tick and tick.label_x and tick.label_y %}
                      <text x="{{ tick.label_x }}" y="{{ tick.label_y }}" text-anchor="{{ tick.anchor | default: 'middle' }}" data-fit-value="true" textLength="30" lengthAdjust="spacingAndGlyphs">
                        {{- tick.label | default: '—' -}}
                      </text>
                    {% endif %}
                  {% endfor %}
                </g>
              {% endif %}
              
              <!-- Asteroids (calculated by backend) -->
              {% if radar_asteroids_full and radar_asteroids_full.size > 0 %}
                <g class="radar-asteroids-group">
                  {% for ast in radar_asteroids_full %}
                    {% if ast and ast.x and ast.y %}
                      <circle cx="{{ ast.x }}" cy="{{ ast.y }}" r="{{ ast.r | default: 3 }}" {% if ast.is_hazardous %}fill="currentColor"{% endif %} />
                    {% endif %}
                  {% endfor %}
                </g>
                <g fill="currentColor">
                  {% for ast in radar_asteroids_full %}
                    {% if ast and ast.label_x1 and ast.label_y1 %}
                      {% if ast.name_part_2 %}
                        <text x="{{ ast.label_x1 }}" y="{{ ast.label_y1 }}" text-anchor="{{ ast.anchor | default: 'start' }}" data-fit-value="true" textLength="65" lengthAdjust="spacingAndGlyphs" class="text--bold">{{ ast.name_part_1 }}</text>
                        <text x="{{ ast.label_x2 }}" y="{{ ast.label_y2 }}" text-anchor="{{ ast.anchor | default: 'start' }}" data-fit-value="true" textLength="65" lengthAdjust="spacingAndGlyphs" class="text--bold">{{ ast.name_part_2 }}</text>
                      {% else %}
                        <text x="{{ ast.label_x1 }}" y="{{ ast.label_y1 }}" text-anchor="{{ ast.anchor | default: 'start' }}" data-fit-value="true" textLength="65" lengthAdjust="spacingAndGlyphs" class="text--bold">{{ ast.name_part_1 }}</text>
                      {% endif %}
                    {% endif %}
                  {% endfor %}
                </g>
              {% endif %}
            </svg>
      {% else %}
        <div class="p--4 bg--gray-75 text--black rounded text--center label grow flex layout--center-x layout--center-y">
          Scan in progress... No telemetry data available.
        </div>
      {% endif %}
    </div>
    
    <!-- Right Column: Status & Schedule Details -->
    <div class="col--span-6 flex flex--col gap--medium">
      {% if radar_ticks_full and radar_ticks_full.size > 0 %}
        <!-- Header -->
        <div class="title text--bold text--xsmall lg:text--large portrait:text--xsmall">PLANETARY DEFENSE</div>
        <div class="label mb--1">NEO RADAR MONITOR</div>
        
        <!-- System Status Banner -->
        {% if system_status %}
          {% if system_status contains "WARNING" %}
            <div class="bg--black text--white p--2 rounded text--center text--bold mb--1">
              {{ system_status }}
            </div>
          {% else %}
            <div class="p--2 rounded bg--gray-70 text--black text--center text--bold mb--1">
              {{ system_status }}
            </div>
          {% endif %}
        {% endif %}
        
        <!-- Key Statistics Summary -->
        <div class="flex flex--row gap--small mb--1">
          <div class="grow text--center bg--gray-75 text--black rounded p--1">
            <div class="label text--bold">NEOS DETECTED</div>
            <div class="value value--base lg:value--large">{{ total_count | default: '—' }}</div>
          </div>
          <div class="grow text--center bg--gray-75 text--black rounded p--1">
            <div class="label text--bold">CLOSEST APPROACH</div>
            <div class="value value--base lg:value--large">{{ closest_dist_ld | default: '—' }}</div>
          </div>
        </div>
        
        <!-- Closest Scheduled Objects -->
        <div class="flex flex--col gap--small" data-overflow="true">
          <div class="label text--bold">CLOSEST SCHEDULED FLYBYS</div>
          
          {% if closest_list and closest_list.size > 0 %}
            {% assign list_count = 0 %}
            {% for item in closest_list %}
              {% if list_count < 2 %}
                <div class="flex flex--row layout--center-y gap--small p--2 rounded 1bit:bg--white 4bit:bg--gray-75 text--black" style="max-height: 48px; overflow: hidden;">
                  <div class="grow">
                    <div class="text--bold text--medium" data-overflow="true" data-clamp="1">{{ item.name | default: '—' }}</div>
                    <div class="label text--small" data-overflow="true" data-clamp="1">{{ item.time_str | default: '—' }} &bull; Size: {{ item.size_m | default: '—' }}</div>
                  </div>
                  <div class="text--right flex flex--col layout--right">
                    <div class="text--bold text--medium" data-overflow="true" data-clamp="1">{{ item.dist_ld | default: '—' }} LD</div>
                    {% if item.is_hazardous != "" and item.is_hazardous != nil %}
                      <span class="bg--black text--white px--2 rounded text--bold text--small">HAZARD</span>
                    {% endif %}
                  </div>
                </div>
                {% assign list_count = list_count | plus: 1 %}
              {% endif %}
            {% endfor %}
          {% endif %}
          
          {% unless closest_list and closest_list.size > 0 %}
            <div class="p--3 bg--gray-75 text--gray-40 rounded text--center label">
              No NEO activity detected.
            </div>
          {% endunless %}
        </div>
      {% else %}
        <div class="p--4 bg--gray-75 text--black rounded text--center label grow flex layout--center-x layout--center-y">
          Radar scan offline. System checking for telemetry updates...
        </div>
      {% endif %}
    </div>
  </div>
</div>
