{% if scan_completed == nil %}
  {% if data.scan_completed != nil %}
    {% assign scan_completed = data.scan_completed %}
  {% elsif chart_asteroids_full and chart_asteroids_full.size > 0 %}
    {% assign scan_completed = true %}
  {% elsif total_count and total_count != '—' and total_count != 0 %}
    {% assign scan_completed = true %}
  {% else %}
    {% assign scan_completed = false %}
  {% endif %}
{% endif %}

{% if data and data.total_count != nil and total_count == nil %}
  {% assign total_count = data.total_count %}
  {% assign upcoming_count = data.upcoming_count %}
  {% assign closest_dist_ld = data.closest_dist_ld %}
  {% assign closest_name = data.closest_name %}
  {% assign max_size_m = data.max_size_m %}
  {% assign last_updated = data.last_updated %}
  {% assign closest_list = data.closest_list %}
  {% assign system_status = data.system_status %}
  {% assign is_alert = data.is_alert %}
  {% assign last_error = data.last_error %}
  {% assign chart_asteroids_full = data.chart_asteroids_full %}
  {% assign chart_ticks_full = data.chart_ticks_full %}
  {% assign chart_gridlines_full = data.chart_gridlines_full %}
  {% assign chart_asteroids_half_horizontal = data.chart_asteroids_half_horizontal %}
  {% assign chart_ticks_half_horizontal = data.chart_ticks_half_horizontal %}
  {% assign chart_gridlines_half_horizontal = data.chart_gridlines_half_horizontal %}
  {% assign chart_asteroids_half_vertical = data.chart_asteroids_half_vertical %}
  {% assign chart_ticks_half_vertical = data.chart_ticks_half_vertical %}
  {% assign chart_gridlines_half_vertical = data.chart_gridlines_half_vertical %}
  {% assign chart_asteroids_quadrant = data.chart_asteroids_quadrant %}
  {% assign chart_ticks_quadrant = data.chart_ticks_quadrant %}
  {% assign chart_gridlines_quadrant = data.chart_gridlines_quadrant %}
{% endif %}

{% template title_bar %}
  <div class="title_bar">
    <svg class="image image-stroke image-stroke--medium" width="24" height="24" viewBox="0 0 24 24" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg">
      <path d="M12,2A10,10,0,1,0,22,12,10,10,0,0,0,12,2Zm1,17a1.5,1.5,0,1,1,1.5-1.5A1.5,1.5,0,0,1,13,19Zm5-5.5a1.5,1.5,0,1,1,1.5-1.5A1.5,1.5,0,0,1,18,13.5ZM12,12a2,2,0,1,1,2-2A2,2,0,0,1,12,12ZM7.5,9A1.5,1.5,0,1,1,9,7.5,1.5,1.5,0,0,1,7.5,9Zm1,7a1.5,1.5,0,1,1,1.5-1.5A1.5,1.5,0,0,1,8.5,16Z" fill="#000"/>
    </svg>
    <span class="title">Asteroids</span>
    {% if trmnl.plugin_settings.instance_name and trmnl.plugin_settings.instance_name != "" %}
      <span class="instance">{{ trmnl.plugin_settings.instance_name }}</span>
    {% endif %}
  </div>
{% endtemplate %}
