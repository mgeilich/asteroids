{% if radar_ticks_half_vertical and radar_ticks_half_vertical.size > 0 %}
<div class="layout layout--col gap--small">
  <!-- Radar Face (220x160 px) -->
  <div class="flex flex--col layout--center-x w--full">
    {% render 'radar_svg', layout: 'half_vertical', ticks: radar_ticks_half_vertical, asteroids: radar_asteroids_half_vertical %}
  </div>
  
  <!-- Bottom Telemetry Banner -->
  <div class="flex flex--row flex--center-y gap--small p--2 w--full">
    <div class="flex flex--col">
      <div class="title title--small">ASTEROIDS</div>
      <div class="label label--small">SCAN: {{ total_count | default: '—' }} NEOs</div>
    </div>
    
    <div class="flex flex--row items--center gap--small ml--auto">
      {% if system_status contains "WARNING" or system_status contains "DEMO" %}
        <span class="label label--error p--1"><strong>ALERT</strong></span>
      {% else %}
        <span class="label label--outline p--1"><strong>NOMINAL</strong></span>
      {% endif %}
    </div>
    
    <div class="flex flex--col items--end ml--auto text--right">
      <span class="label">CLOSEST</span>
      <span class="value value--small">{{ closest_dist_ld | default: '—' }}</span>
    </div>
  </div>

  <!-- Closest Scheduled Flybys -->
  <div class="flex flex--col gap--small w--full p--2">
    <div class="label"><strong>CLOSEST SCHEDULED FLYBYS</strong></div>
    
    {% if closest_list and closest_list.size > 0 %}
      {% for item in closest_list limit: 3 %}
        <div class="flex flex--row flex--center-y gap--small p--1 rounded bg--gray-75 grow">
          <div class="grow">
            <div class="title title--small" data-clamp="1">{{ item.name | default: '—' }}</div>
            <div class="label label--small" data-clamp="1">{{ item.time_str | default: '—' }}</div>
          </div>
          <div class="text--right flex flex--col layout--right">
            <div class="value value--small" data-clamp="1">{{ item.dist_ld | default: '—' }} LD</div>
            {% if item.is_hazardous != "" and item.is_hazardous != nil %}
              <span class="label label--error px--1"><strong>HAZARD</strong></span>
            {% endif %}
          </div>
        </div>
      {% endfor %}
    {% else %}
      <div class="p--2 rounded layout--center-x label">
        No NEO activity detected.
      </div>
    {% endif %}
  </div>
</div>
{% else %}
<div class="layout layout--col layout--center">
  <div class="p--4 label">
    Radar scan offline. System checking for telemetry updates...
  </div>
</div>
{% endif %}
{% render 'title_bar' %}
