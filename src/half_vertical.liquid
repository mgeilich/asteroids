<div class="layout layout--col">
    <div class="layout layout--row portrait:layout--col gap--large p--1 grow w--full">
  
  <!-- Radar Face (380x350 px) -->
  <div class="flex flex--col flex--center-x">
    {% if radar_ticks_half_vertical and radar_ticks_half_vertical.size > 0 %}
       <svg width="280" height="260" viewBox="0 0 280 260" preserveAspectRatio="xMidYMid meet" fill="none" xmlns="http://www.w3.org/2000/svg" class="text--black max-w--full">
        <defs>
          <clipPath id="label-clip">
            <rect x="5" y="5" width="270" height="250" />
          </clipPath>
        </defs>
            <!-- Radar Grid boundaries -->
            <g stroke="currentColor" fill="none">
              <circle cx="140" cy="130" r="124" stroke-width="1" stroke-dasharray="1 5" />
              <circle cx="140" cy="130" r="120" stroke-width="2" />
              
              <!-- Concentric rings -->
              <g stroke-width="1" stroke-dasharray="3 6">
                <circle cx="140" cy="130" r="90" />
                <circle cx="140" cy="130" r="60" />
                <circle cx="140" cy="130" r="30" />
              </g>
              
              <!-- Crosshairs -->
              <line x1="140" y1="6" x2="140" y2="254" stroke-width="1" stroke-dasharray="2 4" />
              <line x1="16" y1="130" x2="264" y2="130" stroke-width="1" stroke-dasharray="2 4" />
            </g>
            
            <!-- Center marker -->
            <circle cx="140" cy="130" r="4" fill="currentColor" />
            
            <!-- Day Ticks (Scaled 150/190) -->
            {% if radar_ticks_half_vertical %}
              <g stroke="currentColor" stroke-width="1.5">
                {% for tick in radar_ticks_half_vertical %}
                  {% if tick and tick.x1 and tick.y1 and tick.x2 and tick.y2 %}
                    <line x1="{{ tick.x1 }}" y1="{{ tick.y1 }}" x2="{{ tick.x2 }}" y2="{{ tick.y2 }}" />
                  {% endif %}
                {% endfor %}
              </g>
            {% endif %}
            
            <!-- Day Ticks Labels -->
             {% if radar_ticks_half_vertical %}
              <g fill="currentColor">
                {% for tick in radar_ticks_half_vertical %}
                  {% if tick and tick.label_x and tick.label_y %}
                    <text x="{{ tick.label_x }}" y="{{ tick.label_y }}" text-anchor="{{ tick.anchor | default: 'middle' }}" class="text--small" fill="currentColor">
                      {{- tick.label | default: '—' -}}
                    </text>
                  {% endif %}
                {% endfor %}
              </g>
            {% endif %}
            
            <!-- Asteroids (Scaled 150/190) -->
            {% if radar_asteroids_half_vertical and radar_asteroids_half_vertical.size > 0 %}
              <g stroke="currentColor" stroke-width="1.5" fill="none">
                {% for ast in radar_asteroids_half_vertical %}
                  {% if ast and ast.x and ast.y %}
                    <circle cx="{{ ast.x }}" cy="{{ ast.y }}" r="{{ ast.r | default: 3 }}" {% if ast.is_hazardous %}fill="currentColor"{% endif %} />
                  {% endif %}
                {% endfor %}
              </g>
              <g fill="currentColor" clip-path="url(#label-clip)">
                {% if radar_asteroids_half_vertical.size == 0 %}
                  <text x="140" y="110" text-anchor="middle" class="text--bold" fill="currentColor">CLEAR SECTOR</text>
                {% endif %}
                {% for ast in radar_asteroids_half_vertical %}
                  {% if ast and ast.label_x1 and ast.label_y1 %}
                    {% if ast.name_part_2 %}
                      <text x="{{ ast.label_x1 }}" y="{{ ast.label_y1 }}" text-anchor="{{ ast.anchor | default: 'start' }}" class="text--bold" fill="currentColor">{{ ast.name_part_1 }}</text>
                      <text x="{{ ast.label_x2 }}" y="{{ ast.label_y2 }}" text-anchor="{{ ast.anchor | default: 'start' }}" class="text--bold" fill="currentColor">{{ ast.name_part_2 }}</text>
                    {% else %}
                      <text x="{{ ast.label_x1 }}" y="{{ ast.label_y1 }}" text-anchor="{{ ast.anchor | default: 'start' }}" class="text--bold" fill="currentColor">{{ ast.name_part_1 }}</text>
                    {% endif %}
                  {% endif %}
                {% endfor %}
              </g>
            {% endif %}
          </svg>
    {% else %}
      <div class="p--4 text--black rounded text--center label grow flex flex--center-x flex--center-y">
        Scan in progress... No telemetry data available.
      </div>
    {% endif %}
  </div>
  
  <!-- Bottom Telemetry Banner -->
  <div class="flex flex--row flex--center-y gap--large p--2 mb--1 w--full landscape:w--auto lg:w--auto">
    {% if radar_ticks_half_vertical and radar_ticks_half_vertical.size > 0 %}
      <div class="flex flex--col">
        <div class="title text--bold text--small lg:text--medium">ASTEROIDS</div>
        <div class="label text--xxsmall lg:text--xsmall">SCAN: {{ total_count | default: '—' }} NEOs</div>
      </div>
      
      <!-- Mini status -->
      {% if system_status %}
        {% if system_status contains "WARNING" %}
          <span class="bg--black text--white p--1 rounded text--bold text--xsmall">ALERT</span>
        {% else %}
          <span class="p--1 rounded label--outline text--black text--bold text--xsmall">NOMINAL</span>
        {% endif %}
      {% endif %}
      
      <div class="flex flex--col items--end">
        <span class="label text--xsmall">CLOSEST</span>
        <span class="value text--bold text--small">{{ closest_dist_ld | default: '—' }}</span>
      </div>
    {% else %}
      <div class="p--2 text--black rounded text--center label grow flex flex--center-x flex--center-y w--full">
        Telemetry offline. Checking for orbital tracking updates...
      </div>
    {% endif %}
    </div>
  </div>
</div>
{% render 'title_bar' %}
