  {% render 'title_bar' %}
  <div class="layout layout--col">
    <div class="flex flex--col portrait:flex--col landscape:flex--row lg:flex--row gap--space-between p--1 grow w--full">
  
  <!-- Radar Face (380x350 px) -->
  <div class="flex flex--col layout--center-x">
    {% if radar_ticks_half_vertical and radar_ticks_half_vertical.size > 0 %}
      <svg width="380" height="350" style="width: 380px; height: 350px;" viewBox="0 0 380 350" preserveAspectRatio="xMidYMid meet" fill="none" xmlns="http://www.w3.org/2000/svg" class="text--black radar-svg">
            <!-- Radar Grid boundaries -->
            <g class="radar-grid-group">
              <circle cx="190" cy="175" r="155" class="grid-outer-boundary grid-outer-boundary--large" />
              <circle cx="190" cy="175" r="150" class="grid-inner-boundary--large" />
              
              <!-- Concentric rings -->
              <g class="grid-range-rings grid-range-rings--large">
                <circle cx="190" cy="175" r="113" />
                <circle cx="190" cy="175" r="75" />
                <circle cx="190" cy="175" r="38" />
              </g>
              
              <!-- Crosshairs -->
              <line x1="190" y1="20" x2="190" y2="330" class="grid-crosshairs" />
              <line x1="35" y1="175" x2="345" y2="175" class="grid-crosshairs" />
            </g>
            
            <!-- Center marker -->
            <circle cx="190" cy="175" r="4" class="radar-center-marker" />
            
            <!-- Day Ticks (Scaled 150/190) -->
            {% if radar_ticks_half_vertical %}
              <g class="radar-ticks-group">
                {% for tick in radar_ticks_half_vertical %}
                  {% if tick and tick.x1 and tick.y1 and tick.x2 and tick.y2 %}
                    <line x1="{{ tick.x1 }}" y1="{{ tick.y1 }}" x2="{{ tick.x2 }}" y2="{{ tick.y2 }}" />
                  {% endif %}
                {% endfor %}
              </g>
            {% endif %}
            
            <!-- Day Ticks Labels -->
            {% if radar_ticks_half_vertical %}
              <g fill="currentColor">
                {% for tick in radar_ticks_half_vertical %}
                  {% if tick and tick.label_x and tick.label_y %}
                    <text x="{{ tick.label_x }}" y="{{ tick.label_y }}" text-anchor="{{ tick.anchor | default: 'middle' }}">
                      {{- tick.label | default: '—' -}}
                    </text>
                  {% endif %}
                {% endfor %}
              </g>
            {% endif %}
            
            <!-- Asteroids (Scaled 150/190) -->
            {% if radar_asteroids_half_vertical and radar_asteroids_half_vertical.size > 0 %}
              <g class="radar-asteroids-group">
                {% for ast in radar_asteroids_half_vertical %}
                  {% if ast and ast.x and ast.y %}
                    <circle cx="{{ ast.x }}" cy="{{ ast.y }}" r="{{ ast.r | default: 3 }}" {% if ast.is_hazardous %}fill="currentColor"{% endif %} />
                  {% endif %}
                {% endfor %}
              </g>
              <g fill="currentColor">
                {% for ast in radar_asteroids_half_vertical %}
                  {% if ast and ast.label_x1 and ast.label_y1 %}
                    {% if ast.name_part_2 %}
                      <text x="{{ ast.label_x1 }}" y="{{ ast.label_y1 }}" text-anchor="{{ ast.anchor | default: 'start' }}" data-fit-value="true" textLength="55" lengthAdjust="spacingAndGlyphs" class="text--bold">{{ ast.name_part_1 }}</text>
                      <text x="{{ ast.label_x2 }}" y="{{ ast.label_y2 }}" text-anchor="{{ ast.anchor | default: 'start' }}" data-fit-value="true" textLength="55" lengthAdjust="spacingAndGlyphs" class="text--bold">{{ ast.name_part_2 }}</text>
                    {% else %}
                      <text x="{{ ast.label_x1 }}" y="{{ ast.label_y1 }}" text-anchor="{{ ast.anchor | default: 'start' }}" data-fit-value="true" textLength="55" lengthAdjust="spacingAndGlyphs" class="text--bold">{{ ast.name_part_1 }}</text>
                    {% endif %}
                  {% endif %}
                {% endfor %}
              </g>
            {% endif %}
          </svg>
    {% else %}
      <div class="p--4 bg--gray-75 text--black rounded text--center label grow flex layout--center-x layout--center-y">
        Scan in progress... No telemetry data available.
      </div>
    {% endif %}
  </div>
  
  <!-- Bottom Telemetry Banner -->
  <div class="flex flex--row layout--center-y gap--space-between p--2 mb--1 w--full landscape:w--auto lg:w--auto">
    {% if radar_ticks_half_vertical and radar_ticks_half_vertical.size > 0 %}
      <div class="flex flex--col">
        <div class="title text--bold text--small lg:text--medium">ASTEROIDS</div>
        <div class="label text--xsmall lg:text--small">SCAN: {{ total_count | default: '—' }} NEOs</div>
      </div>
      
      <!-- Mini status -->
      {% if system_status %}
        {% if system_status contains "WARNING" %}
          <span class="bg--black text--white p--1 rounded text--bold text--xsmall">ALERT</span>
        {% else %}
          <span class="p--1 rounded bg--gray-70 text--black text--bold text--xsmall">NOMINAL</span>
        {% endif %}
      {% endif %}
      
      <div class="flex flex--col items--end">
        <span class="label text--xsmall">CLOSEST</span>
        <span class="value text--bold text--small">{{ closest_dist_ld | default: '—' }}</span>
      </div>
    {% else %}
      <div class="p--2 bg--gray-75 text--black rounded text--center label grow flex layout--center-x layout--center-y w--full">
        Telemetry offline. Checking for orbital tracking updates...
      </div>
    {% endif %}
  </div>
  
    </div>
  </div>
