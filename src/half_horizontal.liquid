{% if radar_ticks_half_horizontal and radar_ticks_half_horizontal.size > 0 %}
<div class="layout layout--col">
  <div class="flex flex--col lg:flex--row gap--small p--1 grow w--full">
    
    <!-- Left Column: Compact Radar (220x160px) -->
    <div class="flex flex--col layout--center-x w--full">
      {% render 'radar_svg', layout: 'half_horizontal', ticks: radar_ticks_half_horizontal, asteroids: radar_asteroids_half_horizontal %}
    </div>
    
    <!-- Right Column: Status Banner & Summary Ticker (540px wide) -->
    <div class="grid grid--cols-1 gap--small grow">
      <!-- System status and refresh banner -->
      <div class="flex flex--row flex--center-y gap--small mb--1">
        <div>
          <div class="title title--small">ASTEROIDS</div>
          <div class="label label--small">Planetary Defense Telemetry</div>
        </div>
        
        <div class="flex flex--row items--center gap--small ml--auto">
          {% if system_status contains "WARNING" or system_status contains "DEMO" %}
            <span class="label label--error p--1"><strong>ALERT</strong></span>
          {% else %}
            <span class="label label--outline p--1"><strong>NOMINAL</strong></span>
          {% endif %}
        </div>
      </div>
      
      <!-- Metrics row -->
      <div class="grid grid--cols-2 gap--small mb--1">
        <div class="bg--gray-75 rounded p--0.5 flex flex--row gap--small layout--center-x layout--center-y">
          <span class="label">COUNT:</span>
          <span class="value value--small">{{ total_count | default: '—' }}</span>
        </div>
        <div class="bg--gray-75 rounded p--0.5 flex flex--row gap--small layout--center-x layout--center-y">
          <span class="label">CLOSEST:</span>
          <span class="value value--small">{{ closest_dist_ld | default: '—' }}</span>
        </div>
      </div>
      
      <!-- Closest list schedule -->
      <div class="grid grid--cols-1 gap--small">
        {% if closest_list and closest_list.size > 0 %}
          <div class="label"><strong>CLOSEST SCHEDULED FLYBYS</strong></div>
          {% for item in closest_list limit: 2 %}
            <div class="flex flex--row flex--center-y gap--small p--1 rounded bg--gray-75 grow">
              <div class="grow">
                <div class="title title--small" data-clamp="1">{{ item.name | default: '—' }}</div>
                <div class="label label--small" data-clamp="1">{{ item.time_str | default: '—' }} &bull; Size: {{ item.size_m | default: '—' }}</div>
              </div>
              <div class="text--right flex flex--col layout--right">
                <div class="value value--small" data-clamp="1">{{ item.dist_ld | default: '—' }} LD</div>
                {% if item.is_hazardous != "" and item.is_hazardous != nil %}
                  <span class="label label--error px--1"><strong>HAZARD</strong></span>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        {% else %}
          <div class="p--2 rounded layout--center-x label">
            No NEO activity detected.
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>
{% else %}
<div class="layout layout--col layout--center">
  <div class="p--4 label">
    Radar scan offline. System checking for telemetry updates...
  </div>
</div>
{% endif %}
{% render 'title_bar' %}
