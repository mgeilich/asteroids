<div class="layout layout--col layout--stretch p--0 gap--xsmall">
  {% if scan_completed %}
    <!-- Header -->
    <div class="flex flex--row flex--center-y gap--xsmall w--full">
      <div class="title title--small">ASTEROIDS</div>
      <div class="ml--auto">
        {% if is_alert %}
          <span class="label label--filled px--1 py--0.5"><strong>ALERT</strong></span>
        {% else %}
          <span class="label label--outline px--1 py--0.5"><strong>NOMINAL</strong></span>
        {% endif %}
      </div>
    </div>
    
    <!-- Hero Metric Block -->
    <div class="flex flex--col flex--center-x py--0.5">
      <div class="value value--base" data-fit-value="true">{{ total_count | default: '0' }}</div>
      <div class="label label--small">UPCOMING NEOS (7 DAYS)</div>
    </div>
    
    <!-- Secondary Glance Callouts -->
    <div class="grid grid--cols-2 gap--xsmall w--full">
      <div class="bg--gray-75 rounded p--0.5 flex flex--col flex--center-x">
        <span class="label label--small">CLOSEST</span>
        <span class="value value--small">{{ closest_dist_ld | default: '—' }}</span>
      </div>
      <div class="bg--gray-75 rounded p--0.5 flex flex--col flex--center-x">
        <span class="label label--small">MAX SIZE</span>
        <span class="value value--small">{{ max_size_m | default: '—' }}</span>
      </div>
    </div>

    <!-- Micro-Status Callout -->
    <div class="rounded bg--gray-75 p--0.5 flex flex--row flex--center-x w--full">
      <span class="label label--small">{% if is_alert %}<strong>HAZARD DETECTED IN SECTOR</strong>{% else %}ALL FLYBYS SAFE (NOMINAL){% endif %}</span>
    </div>
  {% else %}
    <div class="p--2 label">
      {{ last_error | default: 'Timeline scan in progress...' }}
    </div>
  {% endif %}
</div>
{% render 'title_bar' %}
