<div class="layout layout--col gap--small">
  {% if scan_completed %}
    <div class="grid grid--cols-2 gap--small w--full grow p--1">
      
      <!-- Left Column: Linear Coordinate Timeline Chart -->
      <div class="col--span-1 w--full flex flex--col flex--center-x">
        <svg width="360" height="260" viewBox="0 0 360 260" preserveAspectRatio="xMidYMid meet" fill="none" xmlns="http://www.w3.org/2000/svg" class="w--full h--auto">
          <defs>
            <clipPath id="chart-clip-full">
              <rect x="38" y="18" width="310" height="214" />
            </clipPath>
          </defs>

          <!-- Axes & Borders -->
          <g stroke="currentColor" stroke-width="1.5">
            <!-- Y-axis (Distance) & X-axis (Earth/Time) -->
            <line x1="40" y1="20" x2="40" y2="230" />
            <line x1="40" y1="230" x2="345" y2="230" stroke-width="2" />
          </g>

          <!-- Horizontal Distance Gridlines -->
          {% if chart_gridlines_full and chart_gridlines_full.size > 0 %}
            <g stroke="currentColor" stroke-width="1" stroke-dasharray="2 4">
              {% for line in chart_gridlines_full %}
                {% if line and line.y %}
                  <line x1="40" y1="{{ line.y }}" x2="345" y2="{{ line.y }}" />
                {% endif %}
              {% endfor %}
            </g>
            <g fill="currentColor" class="label label--small">
              {% for line in chart_gridlines_full %}
                {% if line and line.y and line.label %}
                  <text x="{{ line.x_label | default: 36 }}" y="{{ line.y }}" dy="3" text-anchor="end">
                    {{- line.label -}}
                  </text>
                {% endif %}
              {% endfor %}
            </g>
          {% endif %}

          <!-- NOW Vertical Centerline -->
          <g stroke="currentColor" stroke-width="1.5" stroke-dasharray="3 3">
            <line x1="{{ now_x_full }}" y1="20" x2="{{ now_x_full }}" y2="230" />
          </g>
          <g fill="currentColor" class="label label--small">
            <text x="{{ now_x_full }}" y="14" text-anchor="middle">NOW (T-0)</text>
            <text x="40" y="244" text-anchor="start">0 LD (EARTH)</text>
          </g>

          <!-- Time Ticks along Bottom X-axis -->
          {% if chart_ticks_full and chart_ticks_full.size > 0 %}
            <g stroke="currentColor" stroke-width="1.5">
              {% for tick in chart_ticks_full %}
                {% if tick and tick.x %}
                  <line x1="{{ tick.x }}" y1="{{ tick.y_tick_top | default: 230 }}" x2="{{ tick.x }}" y2="{{ tick.y_tick_bottom | default: 234 }}" />
                {% endif %}
              {% endfor %}
            </g>
            <g fill="currentColor" class="label label--small">
              {% for tick in chart_ticks_full %}
                {% if tick and tick.x and tick.label and tick.is_now != true %}
                  <text x="{{ tick.x }}" y="{{ tick.y_label | default: 244 }}" text-anchor="middle">
                    {{- tick.label -}}
                  </text>
                {% endif %}
              {% endfor %}
            </g>
          {% endif %}

          <!-- Asteroid Markers and Labels -->
          {% if chart_asteroids_full and chart_asteroids_full.size > 0 %}
            <g stroke="currentColor" stroke-width="1.5" clip-path="url(#chart-clip-full)">
              {% for ast in chart_asteroids_full %}
                {% if ast and ast.x and ast.y %}
                  <circle cx="{{ ast.x }}" cy="{{ ast.y }}" r="{{ ast.r | default: 4 }}" {% if ast.is_hazardous %}fill="currentColor"{% else %}fill="none"{% endif %} />
                {% endif %}
              {% endfor %}
            </g>
            <g fill="currentColor" class="label label--small">
              {% for ast in chart_asteroids_full %}
                {% if ast and ast.label_x and ast.label_y and ast.name %}
                  <text x="{{ ast.label_x }}" y="{{ ast.label_y }}" text-anchor="{{ ast.anchor | default: 'start' }}">
                    {{- ast.name -}}
                  </text>
                {% endif %}
              {% endfor %}
            </g>
          {% else %}
            <g fill="currentColor" class="label">
              <text x="192.5" y="130" text-anchor="middle">NO ASTEROIDS IN RANGE</text>
            </g>
          {% endif %}
        </svg>
      </div>

      <!-- Right Column: Telemetry Header, Stats & Closest Flybys -->
      <div class="col--span-1 w--full flex flex--col">
        <div class="flex flex--col gap--small w--full grow p--1">
          
          <!-- Header / Status Row -->
          <div class="flex flex--row flex--center-y gap--small w--full">
            <div>
              <div class="title title--base">PLANETARY DEFENSE</div>
              <div class="label">NEO TIMELINE MONITOR</div>
            </div>
            
            <div class="flex flex--row flex--center-y gap--small ml--auto">
              {% if system_status contains "WARNING" or system_status contains "DEMO" %}
                <div class="label label--warning p--1 flex flex--row flex--center-x">
                  <strong>{{ system_status }}</strong>
                </div>
              {% else %}
                <div class="label label--outline p--1 flex flex--row flex--center-x">
                  <strong>{{ system_status }}</strong>
                </div>
              {% endif %}
            </div>
          </div>
          
          <!-- Key Statistics Grid -->
          <div class="grid grid--cols-2 gap--small w--full">
            <div class="bg--gray-75 rounded p--1 flex flex--col flex--center-x">
              <span class="label">NEOS IN RANGE</span>
              <span class="value value--base">{{ total_count | default: '—' }}</span>
            </div>
            <div class="bg--gray-75 rounded p--1 flex flex--col flex--center-x">
              <span class="label">CLOSEST APPROACH</span>
              <span class="value value--base">{{ closest_dist_ld | default: '—' }}</span>
            </div>
          </div>
          
          <!-- Closest Scheduled Flybys -->
          <div class="flex flex--col gap--xsmall w--full">
            <div class="label"><strong>CLOSEST SCHEDULED FLYBYS</strong></div>
            
            {% if closest_list and closest_list.size > 0 %}
              <div class="grid grid--cols-1 gap--small w--full">
                {% for item in closest_list limit: 3 %}
                  <div class="rounded bg--gray-75 p--1">
                    <div class="flex flex--row flex--center-y gap--small w--full">
                      <div class="grow">
                        <div class="title title--small" data-clamp="1">{{ item.name | default: '—' }}</div>
                        <div class="label label--small" data-clamp="1">{{ item.time_str | default: '—' }} &bull; Size: {{ item.size_m | default: '—' }}</div>
                      </div>
                      <div class="text--right flex flex--col layout--right">
                        <div class="value value--small" data-clamp="1">{{ item.dist_ld | default: '—' }} LD</div>
                        {% if item.is_hazardous == true %}
                          <span class="label label--warning px--1"><strong>HAZARD</strong></span>
                        {% endif %}
                      </div>
                    </div>
                  </div>
                {% endfor %}
              </div>
            {% else %}
              <div class="p--3 rounded flex flex--row flex--center-x label w--full bg--gray-75">
                No NEO activity detected.
              </div>
            {% endif %}
          </div>
        </div>
      </div>
    </div>
  {% else %}
    <div class="flex flex--col layout--center grow">
      <div class="p--4 label">
        Timeline scan offline. System checking for telemetry updates...
      </div>
    </div>
  {% endif %}
</div>
{% render 'title_bar' %}
