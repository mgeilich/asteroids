<div class="layout layout--col gap--space-between">
    <div class="grid grid--cols-2 portrait:grid--cols-1 gap--large w--full grow p--1">
    
    <!-- Left Column: Radar -->
    <div class="flex flex--col flex--center-x grow">
      {% if radar_ticks_full and radar_ticks_full.size > 0 %}
        <svg width="350" height="330" viewBox="0 0 350 330" preserveAspectRatio="xMidYMid meet" fill="none" xmlns="http://www.w3.org/2000/svg" class="text--black max-w--full">
          <defs>
            <clipPath id="label-clip">
              <rect x="5" y="5" width="340" height="320" />
            </clipPath>
          </defs>
              <!-- Radar Grid Boundaries and Rings -->
              <g stroke="currentColor" fill="none">
                <!-- Outer tick border and radar boundary -->
                <circle cx="175" cy="165" r="159" stroke-width="1" stroke-dasharray="1 5" />
                <circle cx="175" cy="165" r="155" stroke-width="2" />
                
                <!-- Concentric distance rings (10, 20, 30, 40 LD) -->
                <g stroke-width="1" stroke-dasharray="3 6">
                  <circle cx="175" cy="165" r="119" />
                  <circle cx="175" cy="165" r="80" />
                  <circle cx="175" cy="165" r="40" />
                </g>
                
                <!-- Crosshair grid axes -->
                <line x1="175" y1="6" x2="175" y2="324" stroke-width="1" stroke-dasharray="2 4" />
                <line x1="16" y1="165" x2="334" y2="165" stroke-width="1" stroke-dasharray="2 4" />
              </g>
              
              <!-- Center marker representing Earth -->
              <circle cx="175" cy="165" r="4" fill="currentColor" />
              
              <!-- Distance, Center, and Time Labels -->
              <g fill="currentColor" class="text--bold">
                <text x="215" y="160" text-anchor="middle">10 LD</text>
                <text x="255" y="160" text-anchor="middle">20 LD</text>
                <text x="294" y="160" text-anchor="middle">30 LD</text>
                <text x="330" y="160" text-anchor="end">40 LD</text>
                <text x="175" y="179" text-anchor="middle">EARTH</text>
                <text x="175" y="10" text-anchor="middle">NOW (T-0)</text>
              </g>
              
              <!-- Day Ticks (calculated by backend) -->
              {% if radar_ticks_full %}
                <g stroke="currentColor" stroke-width="1.5">
                  {% for tick in radar_ticks_full %}
                    {% if tick and tick.x1 and tick.y1 and tick.x2 and tick.y2 %}
                      <line x1="{{ tick.x1 }}" y1="{{ tick.y1 }}" x2="{{ tick.x2 }}" y2="{{ tick.y2 }}" />
                    {% endif %}
                  {% endfor %}
                </g>
              {% endif %}
              
              <!-- Day Ticks Labels -->
              {% if radar_ticks_full %}
                <g fill="currentColor">
                  {% for tick in radar_ticks_full %}
                    {% if tick and tick.label_x and tick.label_y %}
                      <text x="{{ tick.label_x }}" y="{{ tick.label_y }}" text-anchor="{{ tick.anchor | default: 'middle' }}">
                        {{- tick.label | default: '—' -}}
                      </text>
                    {% endif %}
                  {% endfor %}
                </g>
              {% endif %}
              
              <!-- Asteroids (calculated by backend) -->
              {% if radar_asteroids_full and radar_asteroids_full.size > 0 %}
                <g stroke="currentColor" stroke-width="1.5" fill="none">
                  {% for ast in radar_asteroids_full %}
                    {% if ast and ast.x and ast.y %}
                      <circle cx="{{ ast.x }}" cy="{{ ast.y }}" r="{{ ast.r | default: 3 }}" {% if ast.is_hazardous %}fill="currentColor"{% endif %} />
                    {% endif %}
                  {% endfor %}
                </g>
                <g fill="currentColor" clip-path="url(#label-clip)">
                  {% for ast in radar_asteroids_full %}
                    {% if ast and ast.label_x1 and ast.label_y1 %}
                      {% if ast.name_part_2 %}
                        <text x="{{ ast.label_x1 }}" y="{{ ast.label_y1 }}" text-anchor="{{ ast.anchor | default: 'start' }}" class="text--bold">{{ ast.name_part_1 }}</text>
                        <text x="{{ ast.label_x2 }}" y="{{ ast.label_y2 }}" text-anchor="{{ ast.anchor | default: 'start' }}" class="text--bold">{{ ast.name_part_2 }}</text>
                      {% else %}
                        <text x="{{ ast.label_x1 }}" y="{{ ast.label_y1 }}" text-anchor="{{ ast.anchor | default: 'start' }}" class="text--bold">{{ ast.name_part_1 }}</text>
                      {% endif %}
                    {% endif %}
                  {% endfor %}
                </g>
              {% endif %}
            </svg>
      {% else %}
        <div class="p--4 text--black rounded text--center label grow flex flex--center-x flex--center-y">
          Scan in progress... No telemetry data available.
        </div>
      {% endif %}
    </div>
    
    <!-- Right Column: Status & Schedule Details -->
    <div class="flex flex--col gap--medium grow">
      {% if radar_ticks_full and radar_ticks_full.size > 0 %}
        <!-- Header -->
        <div class="title text--bold text--xsmall lg:text--large portrait:text--xsmall">PLANETARY DEFENSE</div>
        <div class="label mb--1">NEO RADAR MONITOR</div>
        
        <!-- System Status Banner -->
        {% if system_status %}
          {% if system_status contains "WARNING" %}
            <div class="bg--black text--white p--2 rounded text--center text--bold mb--1">
              {{ system_status }}
            </div>
          {% else %}
            <div class="p--2 rounded bg--gray-70 text--black text--center text--bold mb--1">
              {{ system_status }}
            </div>
          {% endif %}
        {% endif %}
        
        <!-- Key Statistics Summary -->
        <div class="flex flex--row gap--small mb--1">
          <div class="grow text--center bg--gray-75 text--black rounded p--1">
            <div class="label text--bold">NEOS DETECTED</div>
            <div class="value value--base lg:value--large">{{ total_count | default: '—' }}</div>
          </div>
          <div class="grow text--center bg--gray-75 text--black rounded p--1">
            <div class="label text--bold">CLOSEST APPROACH</div>
            <div class="value value--base lg:value--large">{{ closest_dist_ld | default: '—' }}</div>
          </div>
        </div>
        
        <!-- Closest Scheduled Flybys -->
        <div class="flex flex--col gap--small">
          <div class="label text--bold">CLOSEST SCHEDULED FLYBY</div>
          
          {% if closest_list.size > 0 %}
            {% for item in closest_list limit: 1 %}
              <div class="flex flex--row flex--center-y gap--small p--2 rounded bg--gray-75 text--black">
                <div class="grow">
                  <div class="text--bold text--medium" data-overflow="true" data-clamp="1">{{ item.name | default: '—' }}</div>
                  <div class="label text--small" data-overflow="true" data-clamp="1">{{ item.time_str | default: '—' }} &bull; Size: {{ item.size_m | default: '—' }}</div>
                </div>
                <div class="text--right flex flex--col layout--right">
                  <div class="text--bold text--medium" data-overflow="true" data-clamp="1">{{ item.dist_ld | default: '—' }} LD</div>
                  {% if item.is_hazardous != "" and item.is_hazardous != nil %}
                    <span class="bg--black text--white px--2 rounded text--bold text--small">HAZARD</span>
                  {% endif %}
                </div>
              </div>
            {% endfor %}
          {% else %}
            <div class="p--3 text--black rounded text--center label">
              No NEO activity detected.
            </div>
          {% endif %}
        </div>
      {% else %}
        <div class="p--4 text--black rounded text--center label grow flex flex--center-x flex--center-y">
          Radar scan offline. System checking for telemetry updates...
        </div>
      {% endif %}
    </div>
  </div>
</div>
{% render 'title_bar' %}
