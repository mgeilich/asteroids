<div class="layout layout--col layout--stretch p--0 gap--xsmall">
  {% if scan_completed %}
    <!-- Header -->
    <div class="flex flex--row flex--center-y gap--xsmall w--full">
      <div class="title title--small">ASTEROIDS</div>
      <div class="ml--auto">
        {% if is_alert %}
          <span class="label label--warning px--1 py--0.5"><strong>ALERT</strong></span>
        {% else %}
          <span class="label label--primary px--1 py--0.5"><strong>NOMINAL</strong></span>
        {% endif %}
      </div>
    </div>
    
    <!-- Hero Metric Block -->
    <div class="flex flex--col flex--center-x py--0.5">
      <div class="value value--large">{{ total_count | default: '0' }}</div>
      <div class="label label--small">UPCOMING NEOS (7 DAYS)</div>
    </div>
    
    <!-- Secondary Glance Callouts -->
    <div class="grid grid--cols-2 gap--xsmall w--full">
      <div class="bg--gray-75 rounded p--0.5 flex flex--col flex--center-x">
        <span class="label label--small">CLOSEST</span>
        <span class="value value--small">{{ closest_dist_ld | default: '—' }}</span>
      </div>
      <div class="bg--gray-75 rounded p--0.5 flex flex--col flex--center-x">
        <span class="label label--small">MAX SIZE</span>
        <span class="value value--small">{{ max_size_m | default: '—' }}</span>
      </div>
    </div>
  {% else %}
    <div class="p--2 label">
      Timeline scan in progress...
    </div>
  {% endif %}
</div>
<div class="title_bar">
  <svg class="image" width="24" height="24" viewBox="0 0 24 24" preserveAspectRatio="xMidYMid meet" xmlns="http://www.w3.org/2000/svg">
    <path d="M12,2A10,10,0,1,0,22,12,10,10,0,0,0,12,2Zm1,17a1.5,1.5,0,1,1,1.5-1.5A1.5,1.5,0,0,1,13,19Zm5-5.5a1.5,1.5,0,1,1,1.5-1.5A1.5,1.5,0,0,1,18,13.5ZM12,12a2,2,0,1,1,2-2A2,2,0,0,1,12,12ZM7.5,9A1.5,1.5,0,1,1,9,7.5,1.5,1.5,0,0,1,7.5,9Zm1,7a1.5,1.5,0,1,1,1.5-1.5A1.5,1.5,0,0,1,8.5,16Z" fill="#000"/>
  </svg>
  <span class="title">Asteroids</span>
  {% if trmnl.plugin_settings.instance_name and trmnl.plugin_settings.instance_name != "" %}
    <span class="instance">{{ trmnl.plugin_settings.instance_name }}</span>
  {% endif %}
</div>
