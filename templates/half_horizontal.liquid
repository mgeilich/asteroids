<div class="layout layout--col">
  {% if scan_completed %}
    <div class="flex flex--col md:flex--row portrait:flex--col gap--xsmall p--0.5 grow w--full">
      
      <!-- Left Column: Compact Linear Timeline (260x150) -->
      <div class="w--full md:w--[260px] lg:w--[340px] flex flex--col flex--center-x">
        <svg width="260" height="150" viewBox="0 0 260 150" preserveAspectRatio="xMidYMid meet" fill="none" xmlns="http://www.w3.org/2000/svg" class="w--full h--auto">
          <defs>
            <clipPath id="chart-clip-half-h">
              <rect x="33" y="14" width="214" height="116" />
            </clipPath>
          </defs>

          <!-- Axes -->
          <g stroke="currentColor" stroke-width="1.5">
            <line x1="35" y1="16" x2="35" y2="128" />
            <line x1="35" y1="128" x2="245" y2="128" stroke-width="2" />
          </g>

          <!-- Gridlines -->
          {% if chart_gridlines_half_horizontal and chart_gridlines_half_horizontal.size > 0 %}
            <g stroke="currentColor" stroke-width="1" stroke-dasharray="2 4">
              {% for line in chart_gridlines_half_horizontal %}
                {% if line and line.y %}
                  <line x1="35" y1="{{ line.y }}" x2="245" y2="{{ line.y }}" />
                {% endif %}
              {% endfor %}
            </g>
            <g fill="currentColor" class="label label--small">
              {% for line in chart_gridlines_half_horizontal %}
                {% if line and line.y and line.label %}
                  <text x="{{ line.x_label | default: 32 }}" y="{{ line.y }}" dy="3" text-anchor="end">
                    {{- line.label -}}
                  </text>
                {% endif %}
              {% endfor %}
            </g>
          {% endif %}

          <!-- NOW Vertical Centerline -->
          <g stroke="currentColor" stroke-width="1.5" stroke-dasharray="3 3">
            <line x1="{{ now_x_half_horizontal }}" y1="16" x2="{{ now_x_half_horizontal }}" y2="128" />
          </g>
          <g fill="currentColor" class="label label--small">
            <text x="{{ now_x_half_horizontal }}" y="11" text-anchor="middle">NOW (T-0)</text>
          </g>

          <!-- Time Ticks along Bottom X-axis -->
          {% if chart_ticks_half_horizontal and chart_ticks_half_horizontal.size > 0 %}
            <g stroke="currentColor" stroke-width="1.5">
              {% for tick in chart_ticks_half_horizontal %}
                {% if tick and tick.x %}
                  <line x1="{{ tick.x }}" y1="{{ tick.y_tick_top | default: 128 }}" x2="{{ tick.x }}" y2="{{ tick.y_tick_bottom | default: 132 }}" />
                {% endif %}
              {% endfor %}
            </g>
            <g fill="currentColor" class="label label--small">
              {% for tick in chart_ticks_half_horizontal %}
                {% if tick and tick.x and tick.label and tick.is_now != true %}
                  <text x="{{ tick.x }}" y="{{ tick.y_label | default: 142 }}" text-anchor="middle">
                    {{- tick.label -}}
                  </text>
                {% endif %}
              {% endfor %}
            </g>
          {% endif %}

          <!-- Asteroid Markers -->
          {% if chart_asteroids_half_horizontal and chart_asteroids_half_horizontal.size > 0 %}
            <g stroke="currentColor" stroke-width="1.5" clip-path="url(#chart-clip-half-h)">
              {% for ast in chart_asteroids_half_horizontal %}
                {% if ast and ast.x and ast.y %}
                  <circle cx="{{ ast.x }}" cy="{{ ast.y }}" r="{{ ast.r | default: 3 }}" {% if ast.is_hazardous %}fill="currentColor"{% else %}fill="none"{% endif %} />
                {% endif %}
              {% endfor %}
            </g>
            <g fill="currentColor" class="label label--small">
              {% for ast in chart_asteroids_half_horizontal %}
                {% if ast and ast.label_x and ast.label_y and ast.name %}
                  <text x="{{ ast.label_x }}" y="{{ ast.label_y }}" text-anchor="{{ ast.anchor | default: 'start' }}">
                    {{- ast.name -}}
                  </text>
                {% endif %}
              {% endfor %}
            </g>
          {% else %}
            <g fill="currentColor" class="label">
              <text x="140" y="75" text-anchor="middle">NO ASTEROIDS IN RANGE</text>
            </g>
          {% endif %}
        </svg>
      </div>

      <!-- Right Column: Status Banner & Summary -->
      <div class="grid grid--cols-1 gap--xsmall grow">
        <!-- Status Row -->
        <div class="flex flex--row flex--center-y gap--xsmall mb--0.5">
          <div>
            <div class="title title--small">ASTEROIDS</div>
            <div class="label label--small">Planetary Defense Telemetry</div>
          </div>
          
          <div class="flex flex--row flex--center-y gap--xsmall ml--auto">
            {% if system_status contains "WARNING" or system_status contains "DEMO" %}
              <span class="label label--warning p--1"><strong>ALERT</strong></span>
            {% else %}
              <span class="label label--outline p--1"><strong>NOMINAL</strong></span>
            {% endif %}
          </div>
        </div>
        
        <!-- Metrics Row -->
        <div class="grid grid--cols-2 gap--xsmall mb--0.5">
          <div class="bg--gray-75 rounded p--0.5 flex flex--row gap--xsmall flex--center-x flex--center-y">
            <span class="label">COUNT:</span>
            <span class="value value--small">{{ total_count | default: '—' }}</span>
          </div>
          <div class="bg--gray-75 rounded p--0.5 flex flex--row gap--xsmall flex--center-x flex--center-y">
            <span class="label">CLOSEST:</span>
            <span class="value value--small">{{ closest_dist_ld | default: '—' }}</span>
          </div>
        </div>
        
        <!-- Closest List Schedule -->
        <div class="grid grid--cols-1 gap--xsmall">
          {% if closest_list and closest_list.size > 0 %}
            <div class="label"><strong>CLOSEST SCHEDULED FLYBYS</strong></div>
            {% for item in closest_list limit: 2 %}
              <div class="flex flex--row flex--center-y gap--xsmall p--0.5 rounded bg--gray-75 grow">
                <div class="grow">
                  <div class="title title--small" data-clamp="1">{{ item.name | default: '—' }}</div>
                  <div class="label label--small" data-clamp="1">{{ item.time_str | default: '—' }} &bull; Size: {{ item.size_m | default: '—' }}</div>
                </div>
                <div class="text--right flex flex--col layout--right">
                  <div class="value value--small" data-clamp="1">{{ item.dist_ld | default: '—' }} LD</div>
                  {% if item.is_hazardous == true %}
                    <span class="label label--warning px--1"><strong>HAZARD</strong></span>
                  {% endif %}
                </div>
              </div>
            {% endfor %}
          {% else %}
            <div class="p--2 rounded flex flex--row flex--center-x label bg--gray-75">
              No NEO activity detected.
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  {% else %}
    <div class="flex flex--col layout--center grow">
      <div class="p--4 label">
        Timeline scan offline. System checking for telemetry updates...
      </div>
    </div>
  {% endif %}
</div>
{% render 'title_bar' %}
