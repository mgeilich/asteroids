<div class="layout layout--col">
  {% if scan_completed %}
    <div class="flex flex--row gap--small p--1 grow w--full">
      
      <!-- Left Column: Compact Radar (220x160px) -->
      <div class="flex flex--col flex--center-x w--full">
        <svg width="220" height="160" viewBox="0 0 220 160" preserveAspectRatio="xMidYMid meet" fill="none" xmlns="http://www.w3.org/2000/svg" class="w--full max-w--full">
          <g stroke="#000000" fill="none">
            <circle cx="110" cy="80" r="70" stroke-width="1.5" stroke-dasharray="1 4" />
            <circle cx="110" cy="80" r="65" stroke-width="2.5" />
            
            <g stroke-width="1.5" stroke-dasharray="2 5">
              <circle cx="110" cy="80" r="49" />
              <circle cx="110" cy="80" r="33" />
              <circle cx="110" cy="80" r="16" />
            </g>
            
            <line x1="110" y1="10" x2="110" y2="150" stroke-width="1.5" stroke-dasharray="2 4" />
            <line x1="40" y1="80" x2="180" y2="80" stroke-width="1.5" stroke-dasharray="2 4" />
          </g>
          
          <circle cx="110" cy="80" r="4" fill="#000000" />
          
          {% if radar_ticks_half_horizontal %}
            <g stroke="#000000" stroke-width="2.5">
              {% for tick in radar_ticks_half_horizontal %}
                {% if tick and tick.x1 and tick.y1 and tick.x2 and tick.y2 %}
                  <line x1="{{ tick.x1 }}" y1="{{ tick.y1 }}" x2="{{ tick.x2 }}" y2="{{ tick.y2 }}" />
                {% endif %}
              {% endfor %}
            </g>
          {% endif %}
          
          {% if radar_ticks_half_horizontal %}
            <g fill="#000000" font="bold 8px sans-serif">
              {% for tick in radar_ticks_half_horizontal %}
                {% if tick and tick.label_x and tick.label_y %}
                  <text x="{{ tick.label_x }}" y="{{ tick.label_y }}" text-anchor="{{ tick.anchor | default: 'middle' }}">
                    {{- tick.label | default: '—' -}}
                  </text>
                {% endif %}
              {% endfor %}
            </g>
          {% endif %}
          
          {% if radar_asteroids_half_horizontal and radar_asteroids_half_horizontal.size > 0 %}
            <g stroke="#000000" stroke-width="2" fill="none">
              {% for ast in radar_asteroids_half_horizontal %}
                {% if ast and ast.x and ast.y %}
                  <circle cx="{{ ast.x }}" cy="{{ ast.y }}" r="{{ ast.r | default: 4 }}" {% if ast.is_hazardous %}fill="#000000"{% endif %} />
                {% endif %}
              {% endfor %}
            </g>
          {% else %}
            <g fill="#000000" font="bold 10px sans-serif">
              <text x="110" y="80" text-anchor="middle">NO ASTEROIDS IN RANGE</text>
            </g>
          {% endif %}
        </svg>
      </div>
      
      <!-- Right Column: Status Banner & Summary Ticker (540px wide) -->
      <div class="grid grid--cols-1 gap--small grow">
        <!-- System status and refresh banner -->
        <div class="flex flex--row flex--center-y gap--small mb--1">
          <div>
            <div class="title title--small">ASTEROIDS</div>
            <div class="label label--small">Planetary Defense Telemetry</div>
          </div>
          
          <div class="flex flex--row items--center gap--small ml--auto">
            {% if system_status contains "WARNING" or system_status contains "DEMO" %}
              <span class="label label--warning p--1"><strong>ALERT</strong></span>
            {% else %}
              <span class="label label--outline p--1"><strong>NOMINAL</strong></span>
            {% endif %}
          </div>
        </div>
        
        <!-- Metrics row -->
        <div class="grid grid--cols-2 gap--small mb--1">
          <div class="bg--gray-75 rounded p--0.5 flex flex--row gap--small flex--center-x flex--center-y">
            <span class="label">COUNT:</span>
            <span class="value value--small">{{ total_count | default: '—' }}</span>
          </div>
          <div class="bg--gray-75 rounded p--0.5 flex flex--row gap--small flex--center-x flex--center-y">
            <span class="label">CLOSEST:</span>
            <span class="value value--small">{{ closest_dist_ld | default: '—' }}</span>
          </div>
        </div>
        
        <!-- Closest list schedule -->
        <div class="grid grid--cols-1 gap--small">
          {% if closest_list and closest_list.size > 0 %}
            <div class="label"><strong>CLOSEST SCHEDULED FLYBYS</strong></div>
            {% for item in closest_list limit: 2 %}
              <div class="flex flex--row flex--center-y gap--small p--1 rounded bg--gray-75 grow">
                <div class="grow">
                  <div class="title title--small" data-clamp="1">{{ item.name | default: '—' }}</div>
                  <div class="label label--small" data-clamp="1">{{ item.time_str | default: '—' }} &bull; Size: {{ item.size_m | default: '—' }}</div>
                </div>
                <div class="text--right flex flex--col layout--right">
                  <div class="value value--small" data-clamp="1">{{ item.dist_ld | default: '—' }} LD</div>
                  {% if item.is_hazardous == true %}
                    <span class="label label--warning px--1"><strong>HAZARD</strong></span>
                  {% endif %}
                </div>
              </div>
            {% endfor %}
          {% else %}
            <div class="p--2 rounded flex flex--row flex--center-x label">
              No NEO activity detected.
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  {% else %}
    <div class="flex flex--col layout--center grow">
      <div class="p--4 label">
        Radar scan offline. System checking for telemetry updates...
      </div>
    </div>
  {% endif %}
</div>
{% render 'title_bar' %}
