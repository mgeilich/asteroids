<div class="layout layout--col layout--stretch p--0">
  {% if scan_completed %}
    <div class="grid grid--cols-12 portrait:grid--cols-1 gap--small p--0.5 grow w--full">
       
      <!-- Left Column: Linear Timeline (5 cols) -->
      <div class="col--span-5 portrait:col--span-12 flex flex--col flex--center-x">
        <svg width="280" height="150" viewBox="0 0 280 150" preserveAspectRatio="xMidYMid meet" fill="none" xmlns="http://www.w3.org/2000/svg" class="w--full h--auto">
          <defs>
            <clipPath id="chart-clip-half-h">
              <rect x="46" y="16" width="226" height="114" />
            </clipPath>
          </defs>

          <!-- Axes -->
          <g stroke="#000" stroke-width="1.5">
            <line x1="48" y1="18" x2="48" y2="128" />
            <line x1="48" y1="128" x2="270" y2="128" stroke-width="2" />
          </g>

          <!-- Gridlines -->
          {% if chart_gridlines_half_horizontal and chart_gridlines_half_horizontal.size > 0 %}
            <g stroke="#000" stroke-width="1" stroke-dasharray="2 4">
              {% for line in chart_gridlines_half_horizontal %}
                {% if line and line.y %}
                  <line x1="48" y1="{{ line.y }}" x2="270" y2="{{ line.y }}" />
                {% endif %}
              {% endfor %}
            </g>
            <g fill="#000">
              {% for line in chart_gridlines_half_horizontal %}
                {% if line and line.y and line.label %}
                  <text x="{{ line.x_label | default: 44 }}" y="{{ line.y }}" dy="3" text-anchor="end">
                    {{- line.label -}}
                  </text>
                {% endif %}
              {% endfor %}
              <text x="44" y="128" dy="3" text-anchor="end">Earth</text>
            </g>
          {% endif %}

          <!-- Header Labels -->
          <g fill="#000" font-weight="bold">
            <text x="48" y="14" text-anchor="start">NOW (T-0)</text>
            <text x="270" y="14" text-anchor="end">T+7D</text>
          </g>

          <!-- Time Ticks along Bottom X-axis -->
          {% if chart_ticks_half_horizontal and chart_ticks_half_horizontal.size > 0 %}
            <g stroke="#000" stroke-width="1.5">
              {% for tick in chart_ticks_half_horizontal %}
                {% if tick and tick.x %}
                  <line x1="{{ tick.x }}" y1="{{ tick.y_tick_top | default: 128 }}" x2="{{ tick.x }}" y2="{{ tick.y_tick_bottom | default: 132 }}" />
                {% endif %}
              {% endfor %}
            </g>
            <g fill="#000">
              {% for tick in chart_ticks_half_horizontal %}
                {% if tick and tick.x and tick.label and tick.is_now != true %}
                  <text x="{{ tick.x }}" y="{{ tick.y_label | default: 142 }}" text-anchor="middle">
                    {{- tick.label -}}
                  </text>
                {% endif %}
              {% endfor %}
            </g>
          {% endif %}

          <!-- Asteroid Markers and Labels -->
          {% if chart_asteroids_half_horizontal and chart_asteroids_half_horizontal.size > 0 %}
            <g stroke="#000" stroke-width="1.5" clip-path="url(#chart-clip-half-h)">
              {% for ast in chart_asteroids_half_horizontal %}
                {% if ast and ast.x and ast.y %}
                  <circle cx="{{ ast.x }}" cy="{{ ast.y }}" r="{{ ast.r | default: 3 }}" {% if ast.is_hazardous %}fill="#000"{% else %}fill="none"{% endif %} />
                {% endif %}
              {% endfor %}
            </g>
            <g fill="#000" clip-path="url(#chart-clip-half-h)">
              {% for ast in chart_asteroids_half_horizontal %}
                {% if ast and ast.label_x and ast.label_y and ast.name %}
                  <text x="{{ ast.label_x }}" y="{{ ast.label_y }}" text-anchor="{{ ast.anchor | default: 'start' }}">
                    {{- ast.name -}}
                  </text>
                {% endif %}
              {% endfor %}
            </g>
          {% else %}
            <g fill="#000">
              <text x="160" y="75" text-anchor="middle">NO ASTEROIDS IN RANGE</text>
            </g>
          {% endif %}
        </svg>
      </div>

      <!-- Right Column: Status Banner & Summary (7 cols) -->
      <div class="col--span-7 portrait:col--span-12 flex flex--col gap--xsmall">
        <!-- Status Row -->
        <div class="flex flex--row flex--center-y gap--xsmall">
          <div>
            <div class="title title--small">ASTEROIDS</div>
            <div class="label label--small">Planetary Defense</div>
          </div>
          
          <div class="layout--right flex flex--row flex--center-y gap--xsmall">
            {% if is_alert %}
              <span class="label label--filled px--1 py--0.5"><strong>ALERT</strong></span>
            {% else %}
              <span class="label label--outline px--1 py--0.5"><strong>NOMINAL</strong></span>
            {% endif %}
          </div>
        </div>
        
        <!-- Metrics Row (Reflows to 1 column in portrait) -->
        <div class="grid grid--cols-2 portrait:grid--cols-1 gap--xsmall">
          <div class="bg--gray-75 rounded p--0.5 flex flex--row gap--xsmall flex--center-x flex--center-y">
            <span class="label">UPCOMING:</span>
            <span class="value value--small">{{ total_count | default: '—' }}</span>
          </div>
          <div class="bg--gray-75 rounded p--0.5 flex flex--row gap--xsmall flex--center-x flex--center-y">
            <span class="label">CLOSEST:</span>
            <span class="value value--small">{{ closest_dist_ld | default: '—' }}</span>
          </div>
        </div>
        
        <!-- Closest List Schedule -->
        <div class="flex flex--col gap--xsmall">
          <div class="label"><strong>CLOSEST SCHEDULED FLYBYS</strong></div>
          {% if closest_list and closest_list.size > 0 %}
            {% for item in closest_list limit: 2 %}
              <div class="flex flex--row flex--center-y gap--space-between p--0.5 rounded bg--gray-75">
                <div class="grow">
                  <div class="title title--small" data-clamp="1">{{ item.name | default: '—' }}</div>
                  <div class="label label--small" data-clamp="1">{{ item.time_str | default: '—' }} &bull; Size: {{ item.size_m | default: '—' }}</div>
                </div>
                <div class="layout--right text--right flex flex--col">
                  <div class="value value--small" data-clamp="1">{{ item.dist_ld | default: '—' }} LD</div>
                  {% if item.is_hazardous == true %}
                    <span class="label label--filled px--1"><strong>HAZARD</strong></span>
                  {% endif %}
                </div>
              </div>
            {% endfor %}
          {% else %}
            <div class="p--1 rounded flex flex--row flex--center-x label bg--gray-75">
              No NEO activity detected.
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  {% else %}
    <div class="flex flex--col layout--center grow">
      <div class="p--4 label">
        {{ last_error | default: 'Timeline scan offline. System checking for telemetry updates...' }}
      </div>
    </div>
  {% endif %}
</div>
{% render 'title_bar' %}
