  {% render 'title_bar' %}
  <div class="layout layout--col">
    <div class="flex flex--col lg:flex--row portrait:flex--col landscape:flex--row gap--medium w--full grow p--1">
    
    <!-- Left Column: Compact Radar (220x160px) -->
    <div class="flex flex--col layout--center">
      {% if radar_ticks_half_horizontal and radar_ticks_half_horizontal.size > 0 %}
        <svg width="220" height="160" viewBox="0 0 220 160" preserveAspectRatio="xMidYMid meet" fill="none" xmlns="http://www.w3.org/2000/svg" class="text--black">
          <style>
            .tick-label-small-regular { font-size: 10px; fill: currentColor; }
          </style>
              <!-- Radar Grid boundaries -->
              <g stroke="currentColor" fill="none">
                <circle cx="110" cy="80" r="70" stroke-width="1" stroke-dasharray="1,4" />
                <circle cx="110" cy="80" r="65" stroke-width="1.5" />
                
                <!-- Concentric rings -->
                <g stroke-width="1" stroke-dasharray="2,5">
                  <circle cx="110" cy="80" r="49" />
                  <circle cx="110" cy="80" r="33" />
                  <circle cx="110" cy="80" r="16" />
                </g>
                
                <!-- Crosshairs -->
                <line x1="110" y1="10" x2="110" y2="150" stroke-width="1" stroke-dasharray="2,4" />
                <line x1="40" y1="80" x2="180" y2="80" stroke-width="1" stroke-dasharray="2,4" />
              </g>
              
              <!-- Center Earth marker -->
              <circle cx="110" cy="80" r="2.5" fill="currentColor" />
              
              <!-- Day Ticks (calculated by backend) -->
              {% if radar_ticks_half_horizontal %}
                <g stroke="currentColor" stroke-width="1">
                  {% for tick in radar_ticks_half_horizontal %}
                    {% if tick and tick.x1 and tick.y1 and tick.x2 and tick.y2 %}
                      <line x1="{{ tick.x1 }}" y1="{{ tick.y1 }}" x2="{{ tick.x2 }}" y2="{{ tick.y2 }}" />
                    {% endif %}
                  {% endfor %}
                </g>
              {% endif %}
              
              <!-- Day Tick Labels -->
              {% if radar_ticks_half_horizontal %}
                <g class="tick-label-small-regular">
                  {% for tick in radar_ticks_half_horizontal %}
                    {% if tick and tick.label_x and tick.label_y %}
                      <text x="{{ tick.label_x }}" y="{{ tick.label_y }}" text-anchor="{{ tick.anchor | default: 'middle' }}">
                        {{- tick.label | default: '—' -}}
                      </text>
                    {% endif %}
                  {% endfor %}
                </g>
              {% endif %}
              
              <!-- Asteroids (Scaled 65/190, no text labels to prevent overlap in compact mode) -->
              {% if radar_asteroids_half_horizontal and radar_asteroids_half_horizontal.size > 0 %}
                <g stroke="currentColor" stroke-width="1.5" fill="none">
                  {% for ast in radar_asteroids_half_horizontal %}
                    {% if ast and ast.x and ast.y %}
                      <circle cx="{{ ast.x }}" cy="{{ ast.y }}" r="{{ ast.r | default: 3 }}" {% if ast.is_hazardous %}fill="currentColor"{% endif %} />
                    {% endif %}
                  {% endfor %}
                </g>
              {% endif %}
            </svg>
      {% else %}
        <div class="p--3 bg--gray-75 text--black rounded text--center label grow layout--center">
          Scan in progress... No telemetry data available.
        </div>
      {% endif %}
    </div>
    
    <!-- Right Column: Status Banner & Summary Ticker (540px wide) -->
    <div class="flex flex--col gap--small grow">
      {% if radar_ticks_half_horizontal and radar_ticks_half_horizontal.size > 0 %}
        <!-- Top header + warning status -->
        <div class="flex flex--row layout--bottom gap--space-between mb--1">
          <div>
            <div class="title text--bold text--small lg:text--medium">ASTEROIDS</div>
            <div class="label text--xsmall lg:text--small">Planetary Defense Telemetry</div>
          </div>
          
          {% if system_status %}
            {% if system_status contains "WARNING" %}
              <span class="bg--black text--white p--1 rounded text--bold text--xsmall">ALERT</span>
            {% else %}
              <span class="p--1 rounded bg--gray-70 text--black text--bold text--xsmall">NOMINAL</span>
            {% endif %}
          {% endif %}
        </div>
        
        <!-- Metrics row -->
        <div class="flex flex--row gap--small mb--1">
          <div class="grow text--center bg--gray-75 text--black rounded p--1 flex flex--row gap--small layout--center">
            <span class="label text--xsmall">COUNT:</span>
            <span class="value text--bold text--xsmall">{{ total_count | default: '—' }}</span>
          </div>
          <div class="grow text--center bg--gray-75 text--black rounded p--1 flex flex--row gap--small layout--center">
            <span class="label text--xsmall">CLOSEST:</span>
            <span class="value text--bold text--xsmall">{{ closest_dist_ld | default: '—' }}</span>
          </div>
        </div>
        
        <!-- Closest list schedule (only 1 closest object to fit in horizontal e-ink view height) -->
        <div class="flex flex--col gap--small">
          {% if closest_list and closest_list.size > 0 %}
            {% assign list_count = 0 %}
            {% for item in closest_list %}
              {% if list_count < 1 %}
                <div class="flex flex--row layout--center gap--small p--2 rounded 1bit:bg--white 4bit:bg--gray-75 text--black grow">
                  <div class="grow">
                    <div class="text--bold text--medium">{{ item.name | default: '—' }}</div>
                    <div class="label text--small">{{ item.time_str | default: '—' }} &bull; Size: {{ item.size_m | default: '—' }}</div>
                  </div>
                  <div class="text--right flex flex--col layout--right">
                    <div class="text--bold text--medium">{{ item.dist_ld | default: '—' }} LD</div>
                    {% if item.is_hazardous != "" and item.is_hazardous != nil %}
                      <span class="bg--black text--white px--2 rounded text--bold text--small">HAZARD</span>
                    {% endif %}
                  </div>
                </div>
                {% assign list_count = list_count | plus: 1 %}
              {% endif %}
            {% endfor %}
          {% endif %}
          
          {% unless closest_list and closest_list.size > 0 %}
            <div class="p--2 bg--gray-75 text--gray-40 rounded text--center label">
              No NEO activity detected.
            </div>
          {% endunless %}
        </div>
      {% else %}
        <div class="p--3 bg--gray-75 text--black rounded text--center label grow layout--center">
          Telemetry offline. System checking for updates...
        </div>
      {% endif %}
    </div>
  </div>
  
    </div>
  </div>
