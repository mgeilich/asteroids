<div class="layout layout--col layout--stretch p--0 gap--xsmall">
  {% if scan_completed %}
    <!-- Top Half: Linear Timeline Chart (360x160) -->
    <div class="w--full flex flex--col flex--center-x">
      <svg width="360" height="160" viewBox="0 0 360 160" preserveAspectRatio="xMidYMid meet" fill="none" font-family="sans-serif" xmlns="http://www.w3.org/2000/svg" class="w--full h--auto">
        <defs>
          <clipPath id="chart-clip-half-v">
            <rect x="46" y="16" width="306" height="122" />
          </clipPath>
        </defs>

        <!-- Axes -->
        <g stroke="#000" stroke-width="1.5">
          <line x1="48" y1="16" x2="48" y2="135" />
          <line x1="48" y1="135" x2="350" y2="135" stroke-width="2" />
        </g>

        <!-- Horizontal Gridlines -->
        {% if chart_gridlines_half_vertical and chart_gridlines_half_vertical.size > 0 %}
          <g stroke="#000" stroke-width="1" stroke-dasharray="2 4">
            {% for line in chart_gridlines_half_vertical %}
              {% if line and line.y %}
                <line x1="48" y1="{{ line.y }}" x2="350" y2="{{ line.y }}" />
              {% endif %}
            {% endfor %}
          </g>
          <g fill="#000" font-family="sans-serif">
            {% for line in chart_gridlines_half_vertical %}
              {% if line and line.y and line.label %}
                <text x="{{ line.x_label | default: 44 }}" y="{{ line.y }}" dy="3" text-anchor="end">
                  {{- line.label -}}
                </text>
              {% endif %}
            {% endfor %}
            <text x="44" y="135" dy="3" text-anchor="end">Earth</text>
          </g>
        {% endif %}

        <!-- Header Labels -->
        <g fill="#000" font-weight="bold" font-family="sans-serif">
          <text x="48" y="12" text-anchor="start">NOW (T-0)</text>
          <text x="350" y="12" text-anchor="end">T+7 DAYS</text>
        </g>

        <!-- Time Ticks along Bottom X-axis -->
        {% if chart_ticks_half_vertical and chart_ticks_half_vertical.size > 0 %}
          <g stroke="#000" stroke-width="1.5">
            {% for tick in chart_ticks_half_vertical %}
              {% if tick and tick.x %}
                <line x1="{{ tick.x }}" y1="{{ tick.y_tick_top | default: 135 }}" x2="{{ tick.x }}" y2="{{ tick.y_tick_bottom | default: 139 }}" />
              {% endif %}
            {% endfor %}
          </g>
          <g fill="#000" font-family="sans-serif">
            {% for tick in chart_ticks_half_vertical %}
              {% if tick and tick.x and tick.label and tick.is_now != true %}
                <text x="{{ tick.x }}" y="{{ tick.y_label | default: 150 }}" text-anchor="middle">
                  {{- tick.label -}}
                </text>
              {% endif %}
            {% endfor %}
          </g>
        {% endif %}

        <!-- Asteroid Markers -->
        {% if chart_asteroids_half_vertical and chart_asteroids_half_vertical.size > 0 %}
          <g stroke="#000" stroke-width="1.5" clip-path="url(#chart-clip-half-v)">
            {% for ast in chart_asteroids_half_vertical %}
              {% if ast and ast.x and ast.y %}
                <circle cx="{{ ast.x }}" cy="{{ ast.y }}" r="{{ ast.r | default: 4 }}" {% if ast.is_hazardous %}fill="#000"{% else %}fill="none"{% endif %} />
              {% endif %}
            {% endfor %}
          </g>
          <g fill="#000" font-family="sans-serif" clip-path="url(#chart-clip-half-v)">
            {% for ast in chart_asteroids_half_vertical %}
              {% if ast and ast.label_x and ast.label_y and ast.name %}
                <text x="{{ ast.label_x }}" y="{{ ast.label_y }}" text-anchor="{{ ast.anchor | default: 'start' }}">
                  {{- ast.name -}}
                </text>
              {% endif %}
            {% endfor %}
          </g>
        {% else %}
          <g fill="#000" font-family="sans-serif">
            <text x="192.5" y="80" text-anchor="middle">NO ASTEROIDS IN RANGE</text>
          </g>
        {% endif %}
      </svg>
    </div>
    
    <!-- Middle Telemetry Status Row -->
    <div class="flex flex--row flex--center-y gap--small px--1 py--0.5 w--full">
      <div class="flex flex--col">
        <div class="title title--small">ASTEROIDS</div>
        <div class="label label--small">UPCOMING: {{ total_count | default: '—' }} NEOs</div>
      </div>
      
      <div class="flex flex--row flex--center-y gap--xsmall ml--auto">
        {% if is_alert %}
          <span class="label label--filled px--1 py--0.5">ALERT</span>
        {% else %}
          <span class="label label--outline px--1 py--0.5">NOMINAL</span>
        {% endif %}
      </div>
      
      <div class="flex flex--col items--end text--right ml--auto">
        <span class="label label--small">CLOSEST</span>
        <span class="value value--small">{{ closest_dist_ld | default: '—' }}</span>
      </div>
    </div>

    <!-- Bottom: Closest Scheduled Flybys (2 items for clean vertical space) -->
    <div class="flex flex--col gap--xsmall w--full px--1">
      <div class="label">CLOSEST SCHEDULED FLYBYS</div>
      
      {% if closest_list and closest_list.size > 0 %}
        {% for item in closest_list limit: 2 %}
          <div class="flex flex--row flex--center-y gap--space-between p--0.5 rounded bg--gray-75">
            <div class="grow">
              <div class="title title--small" data-clamp="1">{{ item.name | default: '—' }}</div>
              <div class="label label--small" data-clamp="1">{{ item.time_str | default: '—' }} &bull; Size: {{ item.size_m | default: '—' }}</div>
            </div>
            <div class="text--right flex flex--col ml--auto">
              <div class="value value--small" data-clamp="1">{{ item.dist_ld | default: '—' }} LD</div>
              {% if item.is_hazardous == true %}
                <span class="label label--filled px--1">HAZARD</span>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      {% else %}
        <div class="p--1 rounded flex flex--row flex--center-x label bg--gray-75">
          No NEO activity detected.
        </div>
      {% endif %}
    </div>
  {% else %}
    <div class="flex flex--col layout--center grow">
      <div class="p--4 label">
        {{ last_error | default: 'Timeline scan offline. System checking for telemetry updates...' }}
      </div>
    </div>
  {% endif %}
</div>
{% render 'title_bar' %}
