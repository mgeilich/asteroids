{% if radar_ticks_half_vertical and radar_ticks_half_vertical.size > 0 %}
<div class="layout layout--col gap--small">
  <!-- Radar Face (220x160 px) -->
  <div class="flex flex--col flex--center-x mx--auto">
    <svg width="220" height="160" viewBox="0 0 220 160" preserveAspectRatio="xMidYMid meet" fill="none" xmlns="http://www.w3.org/2000/svg" class="text--black">
      <!-- Radar Grid boundaries -->
      <g stroke="currentColor" fill="none">
        <circle cx="110" cy="80" r="70" stroke-width="1" stroke-dasharray="1 4" />
        <circle cx="110" cy="80" r="65" stroke-width="1.5" />
        
        <!-- Concentric rings -->
        <g stroke-width="1" stroke-dasharray="2 5">
          <circle cx="110" cy="80" r="49" />
          <circle cx="110" cy="80" r="33" />
          <circle cx="110" cy="80" r="16" />
        </g>
        
        <!-- Crosshairs -->
        <line x1="110" y1="10" x2="110" y2="150" stroke-width="1" stroke-dasharray="2 4" />
        <line x1="40" y1="80" x2="180" y2="80" stroke-width="1" stroke-dasharray="2 4" />
      </g>
      
      <!-- Center Earth marker -->
      <circle cx="110" cy="80" r="2.5" fill="currentColor" />
      
      <!-- Day Ticks (calculated by backend) -->
      {% if radar_ticks_half_vertical %}
        <g stroke="currentColor" stroke-width="1.5">
          {% for tick in radar_ticks_half_vertical %}
            {% if tick and tick.x1 and tick.y1 and tick.x2 and tick.y2 %}
              <line x1="{{ tick.x1 }}" y1="{{ tick.y1 }}" x2="{{ tick.x2 }}" y2="{{ tick.y2 }}" />
            {% endif %}
          {% endfor %}
        </g>
      {% endif %}
      
      <!-- Day Tick Labels -->
      {% if radar_ticks_half_vertical %}
        <g fill="currentColor" font="bold 8px sans-serif">
          {% for tick in radar_ticks_half_vertical %}
            {% if tick and tick.label_x and tick.label_y %}
              <text x="{{ tick.label_x }}" y="{{ tick.label_y }}" text-anchor="{{ tick.anchor | default: 'middle' }}">
                {{- tick.label | default: '—' -}}
              </text>
            {% endif %}
          {% endfor %}
        </g>
      {% endif %}
      
      <!-- Asteroids (Scaled 65/190, no text labels to prevent overlap in compact mode) -->
      {% if radar_asteroids_half_vertical and radar_asteroids_half_vertical.size > 0 %}
        <g stroke="currentColor" stroke-width="1.5" fill="none">
          {% for ast in radar_asteroids_half_vertical %}
            {% if ast and ast.x and ast.y %}
              <circle cx="{{ ast.x }}" cy="{{ ast.y }}" r="{{ ast.r | default: 3 }}" {% if ast.is_hazardous %}fill="currentColor"{% endif %} />
            {% endif %}
          {% endfor %}
        </g>
      {% else %}
        <g fill="currentColor" font="bold 9px sans-serif">
          <text x="110" y="70" text-anchor="middle">CLEAR SECTOR</text>
        </g>
      {% endif %}
    </svg>
  </div>
  
  <!-- Bottom Telemetry Banner -->
  <div class="flex flex--row flex--center-y gap--small p--2 mb--1 w--full landscape:w--auto lg:w--auto">
    {% if radar_ticks_half_vertical and radar_ticks_half_vertical.size > 0 %}
      <div class="flex flex--col">
        <div class="title text--bold text--small lg:text--medium">ASTEROIDS</div>
        <div class="label text--xxsmall lg:text--xsmall">SCAN: {{ total_count | default: '—' }} NEOs</div>
      </div>
      
      <div class="flex flex--row items--center gap--small ml--auto">
        {% if system_status contains "WARNING" %}
          <span class="bg--black text--white p--1 rounded text--bold text--xsmall">ALERT</span>
        {% else %}
          <span class="border rounded bg--white text--black p--1 text--bold text--xsmall">NOMINAL</span>
        {% endif %}
      </div>
      
      <div class="flex flex--col items--end">
        <span class="label text--xsmall">CLOSEST</span>
        <span class="value text--bold text--small">{{ closest_dist_ld | default: '—' }} LD</span>
      </div>
    {% endif %}
  </div>
</div>
{% else %}
<div class="layout layout--col">
  <div class="p--4 text--black rounded text--center label grow flex flex--center-x flex--center-y">
    Radar scan offline. System checking for telemetry updates...
  </div>
</div>
{% endif %}
{% render 'title_bar' %}
