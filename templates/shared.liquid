{% assign scan_completed = data.scan_completed | default: scan_completed %}
{% assign system_status = data.system_status | default: system_status %}
{% assign system_status = system_status | default: 'SYSTEM OFFLINE: SCAN IN PROGRESS' %}
{% assign total_count = data.total_count | default: total_count %}
{% assign total_count = total_count | default: '—' %}
{% assign upcoming_count = data.upcoming_count | default: upcoming_count %}
{% assign upcoming_count = upcoming_count | default: '—' %}
{% assign closest_dist_ld = data.closest_dist_ld | default: closest_dist_ld %}
{% assign closest_dist_ld = closest_dist_ld | default: '—' %}
{% assign closest_name = data.closest_name | default: closest_name %}
{% assign closest_name = closest_name | default: '—' %}
{% assign max_size_m = data.max_size_m | default: max_size_m %}
{% assign max_size_m = max_size_m | default: '—' %}
{% assign last_updated = data.last_updated | default: last_updated %}
{% assign last_updated = last_updated | default: '—' %}
{% assign closest_list = data.closest_list | default: closest_list %}

{% assign is_alert = data.is_alert %}
{% if is_alert == nil %}
  {% assign status_lower = system_status | downcase %}
  {% if status_lower contains "warning" or status_lower contains "demo" or status_lower contains "alert" %}
    {% assign is_alert = true %}
  {% else %}
    {% assign is_alert = false %}
  {% endif %}
{% endif %}

